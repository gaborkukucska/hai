+//! START OF FILE hainet-noslop/src/hub/tor.rs
+//!
+//! Tor for the Home HUB:
+//!
+//! * [`send_line`]: one newline-terminated packet to `<onion>:9999` through the local SOCKS5 proxy.
+//! * [`CreatorOnion`]: publishes the creator identity's onion with `ADD_ONION` on the Tor control
+//!   connection, **without** `Flags=Detach`. The service therefore exists only while this Hub process
+//!   holds the control connection: if the Hub stops, the creator onion disappears with it, and the
+//!   phone can take it back without two owners announcing the same onion for long (single-owner fence).
+//!   The connection is watched and the onion re-added if Tor restarts.
+//!
+//! Only well-formed v3 onion addresses are ever dialled (`is_valid_onion`), so nothing that reaches
+//! the Hub's API can make it connect to an arbitrary host.
+
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::time::Duration;
+use tokio::io::{AsyncBufReadExt, AsyncRead, AsyncWrite, AsyncWriteExt, BufReader};
+use tokio::sync::{watch, Mutex};
+use tracing::{debug, info, warn};
+
+/// The mesh port every NoSlop onion serves (`Constants.MESH_PORT`).
+pub const MESH_PORT: u16 = 9999;
+
+/// `[a-z2-7]{56}.onion`, case-insensitive.
+pub fn is_valid_onion(onion: &str) -> bool {
+    let o = onion.trim().to_ascii_lowercase();
+    let Some(host) = o.strip_suffix(".onion") else { return false };
+    host.len() == 56 && host.bytes().all(|b| b.is_ascii_lowercase() || (b'2'..=b'7').contains(&b))
+}
+
+/// Sends one frame over Tor. Returns true when the whole line was written.
+pub async fn send_line(socks: &str, onion: &str, line: &str, connect_timeout: Duration) -> bool {
+    if !is_valid_onion(onion) {
+        warn!("NOSLOP_HUB: refusing to dial an invalid onion address");
+        return false;
+    }
+    let target = format!("{}:{}", onion.trim().to_ascii_lowercase(), MESH_PORT);
+    match tokio::time::timeout(connect_timeout, tokio_socks::tcp::Socks5Stream::connect(socks, target.as_str())).await {
+        Ok(Ok(mut stream)) => {
+            let mut buf = line.as_bytes().to_vec();
+            buf.push(b'\n');
+            let ok = tokio::time::timeout(Duration::from_secs(60), async {
+                stream.write_all(&buf).await?;
+                stream.flush().await?;
+                stream.shutdown().await
+            }).await;
+            matches!(ok, Ok(Ok(())))
+        }
+        Ok(Err(e)) => { debug!("NOSLOP_HUB: Tor connect to {} failed: {}", short(onion), e); false }
+        Err(_) => { debug!("NOSLOP_HUB: Tor connect to {} timed out", short(onion)); false }
+    }
+}
+
+pub fn short(s: &str) -> String { s.chars().take(12).collect() }
+
+// --- Control port -----------------------------------------------------------------------------
+
+/// Where the Tor control interface is (`HAINET_TOR_CONTROL`: `unix:/path` or `host:port`).
+#[derive(Debug, Clone, PartialEq)]
+pub enum ControlTarget {
+    Unix(PathBuf),
+    Tcp(String),
+}
+
+impl ControlTarget {
+    pub fn parse(s: &str) -> Self {
+        match s.strip_prefix("unix:") { Some(p) => ControlTarget::Unix(PathBuf::from(p)), None => ControlTarget::Tcp(s.to_string()) }
+    }
+}
+
+trait Io: AsyncRead + AsyncWrite + Unpin + Send {}
+impl<T: AsyncRead + AsyncWrite + Unpin + Send> Io for T {}
+
+struct Control {
+    io: BufReader<Box<dyn Io>>,
+}
+
+impl Control {
+    async fn connect(target: &ControlTarget) -> std::io::Result<Self> {
+        let io: Box<dyn Io> = match target {
+            #[cfg(unix)]
+            ControlTarget::Unix(p) => Box::new(tokio::net::UnixStream::connect(p).await?),
+            #[cfg(not(unix))]
+            ControlTarget::Unix(_) => return Err(std::io::Error::other("unix sockets unsupported")),
+            ControlTarget::Tcp(a) => Box::new(tokio::net::TcpStream::connect(a).await?),
+        };
+        Ok(Control { io: BufReader::new(io) })
+    }
+
+    /// Sends a command and reads its reply lines up to the final `NNN ` line.
+    async fn cmd(&mut self, line: &str) -> std::io::Result<Vec<String>> {
+        self.io.get_mut().write_all(format!("{}\r\n", line).as_bytes()).await?;
+        self.io.get_mut().flush().await?;
+        let mut out = Vec::new();
+        loop {
+            let mut l = String::new();
+            let n = tokio::time::timeout(Duration::from_secs(30), self.io.read_line(&mut l)).await
+                .map_err(|_| std::io::Error::new(std::io::ErrorKind::TimedOut, "tor control timeout"))??;
+            if n == 0 { return Err(std::io::Error::new(std::io::ErrorKind::UnexpectedEof, "tor control closed")); }
+            let l = l.trim_end().to_string();
+            let done = l.len() >= 4 && l.as_bytes()[3] == b' ';
+            out.push(l);
+            if done { return Ok(out); }
+        }
+    }
+
+    async fn authenticate(&mut self, password: Option<&str>) -> std::io::Result<()> {
+        let info = self.cmd("PROTOCOLINFO 1").await?;
+        let joined = info.join("\n");
+        let methods = joined.split("METHODS=").nth(1).map(|s| s.split_whitespace().next().unwrap_or("").to_string()).unwrap_or_default();
+        let cookie_file = joined.split("COOKIEFILE=\"").nth(1).and_then(|s| s.split('"').next()).map(|s| s.replace("\\\\", "\\"));
+        let auth_line = if methods.split(',').any(|m| m == "NULL") {
+            "AUTHENTICATE".to_string()
+        } else if methods.split(',').any(|m| m == "COOKIE") && cookie_file.is_some() {
+            let cookie = tokio::fs::read(cookie_file.unwrap()).await?;
+            format!("AUTHENTICATE {}", hex::encode(cookie))
+        } else if methods.split(',').any(|m| m == "HASHEDPASSWORD") && password.is_some() {
+            format!("AUTHENTICATE \"{}\"", password.unwrap().replace('\\', "\\\\").replace('"', "\\\""))
+        } else {
+            return Err(std::io::Error::other(format!("no usable Tor control auth method (offered: {})", methods)));
+        };
+        let r = self.cmd(&auth_line).await?;
+        if r.last().map(|l| l.starts_with("250")).unwrap_or(false) { Ok(()) } else { Err(std::io::Error::other(format!("Tor control auth failed: {:?}", r))) }
+    }
+}
+
+#[derive(Debug, Clone, Default, PartialEq)]
+pub struct OnionStatus {
+    pub published: bool,
+    pub service_id: Option<String>,
+    pub error: Option<String>,
+}
+
+/// Publishes the creator onion while a seed is set (see module docs).
+#[derive(Clone)]
+pub struct CreatorOnion {
+    desired: watch::Sender<Option<[u8; 32]>>,
+    pub status: Arc<Mutex<OnionStatus>>,
+}
+
+impl CreatorOnion {
+    /// Starts the watcher task. `local_port` is where Tor forwards the onion's port 9999.
+    pub fn start(target: ControlTarget, password: Option<String>, local_port: u16) -> Self {
+        let (tx, rx) = watch::channel::<Option<[u8; 32]>>(None);
+        let status = Arc::new(Mutex::new(OnionStatus::default()));
+        let st = status.clone();
+        tokio::spawn(async move { Self::run(target, password, local_port, rx, st).await });
+        CreatorOnion { desired: tx, status }
+    }
+
+    /// Publishes (Some) or withdraws (None) the creator onion.
+    pub fn set(&self, seed: Option<[u8; 32]>) { let _ = self.desired.send(seed); }
+
+    async fn run(target: ControlTarget, password: Option<String>, local_port: u16, mut rx: watch::Receiver<Option<[u8; 32]>>, status: Arc<Mutex<OnionStatus>>) {
+        loop {
+            let seed = *rx.borrow_and_update();
+            let Some(seed) = seed else {
+                *status.lock().await = OnionStatus::default();
+                if rx.changed().await.is_err() { return; }
+                continue;
+            };
+            match Self::publish(&target, password.as_deref(), local_port, &seed).await {
+                Ok((mut ctl, service_id)) => {
+                    info!("🧅 NOSLOP_HUB: creator onion {}.onion published (held by this Hub process)", short(&service_id));
+                    *status.lock().await = OnionStatus { published: true, service_id: Some(service_id.clone()), error: None };
+                    // Hold the control connection; a GETINFO every 60 s tells us when Tor went away.
+                    loop {
+                        tokio::select! {
+                            changed = rx.changed() => {
+                                if changed.is_err() { return; }
+                                let _ = ctl.cmd(&format!("DEL_ONION {}", service_id)).await;
+                                info!("🧅 NOSLOP_HUB: creator onion withdrawn");
+                                break;
+                            }
+                            _ = tokio::time::sleep(Duration::from_secs(60)) => {
+                                if ctl.cmd("GETINFO version").await.is_err() {
+                                    warn!("NOSLOP_HUB: Tor control connection lost; re-publishing the creator onion");
+                                    break;
+                                }
+                            }
+                        }
+                    }
+                    *status.lock().await = OnionStatus::default();
+                }
+                Err(e) => {
+                    warn!("NOSLOP_HUB: could not publish the creator onion: {}", e);
+                    *status.lock().await = OnionStatus { published: false, service_id: None, error: Some(e.to_string()) };
+                    tokio::select! {
+                        changed = rx.changed() => { if changed.is_err() { return; } }
+                        _ = tokio::time::sleep(Duration::from_secs(30)) => {}
+                    }
+                }
+            }
+        }
+    }
+
+    async fn publish(target: &ControlTarget, password: Option<&str>, local_port: u16, seed: &[u8; 32]) -> std::io::Result<(Control, String)> {
+        let mut ctl = Control::connect(target).await?;
+        ctl.authenticate(password).await?;
+        let key = crate::keys::b64_encode(&crate::keys::tor_expanded_secret(seed));
+        let reply = ctl.cmd(&format!("ADD_ONION ED25519-V3:{} Port={},127.0.0.1:{}", key, MESH_PORT, local_port)).await?;
+        if let Some(id) = reply.iter().find_map(|l| l.split("ServiceID=").nth(1)).map(|s| s.trim().to_string()) {
+            return Ok((ctl, id));
+        }
+        Err(std::io::Error::other(format!("ADD_ONION refused: {:?}", reply.last())))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn onion_validation() {
+        assert!(is_valid_onion("ovoezojfnst43rfm7xdm73w2qsibpznz7fiu5gizdplh4cynij3c2tad.onion"));
+        assert!(is_valid_onion("OVOEZOJFNST43RFM7XDM73W2QSIBPZNZ7FIU5GIZDPLH4CYNIJ3C2TAD.onion"));
+        assert!(!is_valid_onion("example.com"));
+        assert!(!is_valid_onion("127.0.0.1"));
+        assert!(!is_valid_onion("ovoezojfnst43rfm7xdm73w2qsibpznz7fiu5gizdplh4cynij3c2ta1.onion"));
+        assert!(!is_valid_onion("short.onion"));
+    }
+
+    #[test]
+    fn control_target_parse() {
+        assert_eq!(ControlTarget::parse("unix:/run/tor/control"), ControlTarget::Unix("/run/tor/control".into()));
+        assert_eq!(ControlTarget::parse("127.0.0.1:9051"), ControlTarget::Tcp("127.0.0.1:9051".into()));
+    }
+}
diff --git a/hainet-noslop/src/json.rs b/hainet-noslop/src/json.rs
new file mode 100644
index 0000000..8b4a1ac
--- /dev/null
+++ b/hainet-noslop/src/json.rs
@@ -0,0 +1,374 @@
+//! START OF FILE hainet-noslop/src/json.rs
+//!
+//! Order-preserving JSON that renders exactly like Gson's `JsonElement.toString()`.
+//!
+//! Why not `serde_json::Value`: the NoSlop envelope signature covers a SHA-256 of the payload *as
+//! Gson renders it* (`EnvelopeAuth.payloadDigest`). To reproduce that digest the Hub must keep the
+//! member order of the wire, keep every number exactly as written (Gson keeps a
+//! `LazilyParsedNumber`'s text, so `1.50` stays `1.50`) and escape strings the way Gson's
+//! `JsonWriter` does (it escapes U+2028/U+2029, serde_json does not). Turning on serde_json's
+//! `preserve_order`/`arbitrary_precision` features would change every crate in the workspace, so
+//! this module has its own small value type.
+//!
+//! Parsing is strict RFC 8259 JSON (Gson's writer only produces that), with limits on depth and size.
+
+use std::fmt::Write as _;
+
+/// Maximum nesting depth accepted by [`parse`].
+pub const MAX_DEPTH: usize = 64;
+
+/// A JSON value with object members kept in wire order and numbers kept as their source text.
+#[derive(Debug, Clone, PartialEq)]
+pub enum JValue {
+    Null,
+    Bool(bool),
+    /// The number exactly as written (valid JSON number syntax).
+    Num(String),
+    Str(String),
+    Arr(Vec<JValue>),
+    Obj(Vec<(String, JValue)>),
+}
+
+#[derive(Debug, thiserror::Error, PartialEq)]
+pub enum JsonError {
+    #[error("unexpected end of input")]
+    Eof,
+    #[error("unexpected character at byte {0}")]
+    Unexpected(usize),
+    #[error("nesting deeper than {MAX_DEPTH}")]
+    TooDeep,
+    #[error("invalid escape at byte {0}")]
+    BadEscape(usize),
+    #[error("trailing characters at byte {0}")]
+    Trailing(usize),
+}
+
+impl JValue {
+    pub fn obj() -> Self { JValue::Obj(Vec::new()) }
+    pub fn str<S: Into<String>>(s: S) -> Self { JValue::Str(s.into()) }
+    pub fn int(n: i64) -> Self { JValue::Num(n.to_string()) }
+
+    /// Appends (or replaces) a member, keeping its position when it already exists.
+    pub fn set<S: Into<String>>(&mut self, key: S, value: JValue) -> &mut Self {
+        if let JValue::Obj(members) = self {
+            let key = key.into();
+            if let Some(slot) = members.iter_mut().find(|(k, _)| *k == key) {
+                slot.1 = value;
+            } else {
+                members.push((key, value));
+            }
+        }
+        self
+    }
+
+    /// Builder form of [`set`](Self::set).
+    pub fn with<S: Into<String>>(mut self, key: S, value: JValue) -> Self { self.set(key, value); self }
+
+    /// Like [`with`](Self::with) but leaves the member out when `value` is `None` (as Gson does
+    /// for a null field).
+    pub fn with_opt<S: Into<String>>(self, key: S, value: Option<JValue>) -> Self {
+        match value { Some(v) => self.with(key, v), None => self }
+    }
+
+    pub fn remove(&mut self, key: &str) -> Option<JValue> {
+        if let JValue::Obj(members) = self {
+            if let Some(i) = members.iter().position(|(k, _)| k == key) {
+                return Some(members.remove(i).1);
+            }
+        }
+        None
+    }
+
+    pub fn get(&self, key: &str) -> Option<&JValue> {
+        match self { JValue::Obj(m) => m.iter().find(|(k, _)| k == key).map(|(_, v)| v), _ => None }
+    }
+
+    /// A string member, treating JSON null as absent.
+    pub fn get_str(&self, key: &str) -> Option<&str> {
+        match self.get(key) { Some(JValue::Str(s)) => Some(s.as_str()), _ => None }
+    }
+
+    /// An integral number member (`i64`), as Gson would coerce a `Long` field. Accepts integral
+    /// text only; a fractional or exponent form yields `None`.
+    pub fn get_i64(&self, key: &str) -> Option<i64> {
+        match self.get(key) { Some(v) => v.as_i64(), None => None }
+    }
+
+    pub fn get_bool(&self, key: &str) -> Option<bool> {
+        match self.get(key) { Some(JValue::Bool(b)) => Some(*b), _ => None }
+    }
+
+    pub fn as_i64(&self) -> Option<i64> {
+        match self { JValue::Num(t) => t.parse::<i64>().ok(), _ => None }
+    }
+    pub fn as_str(&self) -> Option<&str> { match self { JValue::Str(s) => Some(s), _ => None } }
+    pub fn as_array(&self) -> Option<&Vec<JValue>> { match self { JValue::Arr(a) => Some(a), _ => None } }
+    pub fn is_null(&self) -> bool { matches!(self, JValue::Null) }
+
+    /// This value with every object member whose value is null removed, recursively. Nulls inside
+    /// arrays stay (`EnvelopeAuth.withoutNullMembers`).
+    pub fn without_null_members(&self) -> JValue {
+        match self {
+            JValue::Obj(m) => JValue::Obj(
+                m.iter().filter(|(_, v)| !v.is_null()).map(|(k, v)| (k.clone(), v.without_null_members())).collect(),
+            ),
+            JValue::Arr(a) => JValue::Arr(a.iter().map(|v| v.without_null_members()).collect()),
+            other => other.clone(),
+        }
+    }
+
+    /// Gson's compact rendering (`JsonElement.toString()`).
+    pub fn render(&self) -> String {
+        let mut out = String::new();
+        render_into(self, &mut out);
+        out
+    }
+
+    /// Converts to `serde_json::Value` (for storage/API replies; numbers become `serde_json`
+    /// numbers, so this is never used for anything that is signed).
+    pub fn to_serde(&self) -> serde_json::Value {
+        match self {
+            JValue::Null => serde_json::Value::Null,
+            JValue::Bool(b) => serde_json::Value::Bool(*b),
+            JValue::Num(t) => serde_json::from_str(t).unwrap_or(serde_json::Value::Null),
+            JValue::Str(s) => serde_json::Value::String(s.clone()),
+            JValue::Arr(a) => serde_json::Value::Array(a.iter().map(|v| v.to_serde()).collect()),
+            JValue::Obj(m) => {
+                let mut map = serde_json::Map::new();
+                for (k, v) in m { map.insert(k.clone(), v.to_serde()); }
+                serde_json::Value::Object(map)
+            }
+        }
+    }
+}
+
+fn render_into(v: &JValue, out: &mut String) {
+    match v {
+        JValue::Null => out.push_str("null"),
+        JValue::Bool(true) => out.push_str("true"),
+        JValue::Bool(false) => out.push_str("false"),
+        JValue::Num(t) => out.push_str(t),
+        JValue::Str(s) => render_string(s, out),
+        JValue::Arr(a) => {
+            out.push('[');
+            for (i, x) in a.iter().enumerate() {
+                if i > 0 { out.push(','); }
+                render_into(x, out);
+            }
+            out.push(']');
+        }
+        JValue::Obj(m) => {
+            out.push('{');
+            for (i, (k, x)) in m.iter().enumerate() {
+                if i > 0 { out.push(','); }
+                render_string(k, out);
+                out.push(':');
+                render_into(x, out);
+            }
+            out.push('}');
+        }
+    }
+}
+
+/// Gson `JsonWriter` string escaping with `htmlSafe == false` (the default for
+/// `JsonElement.toString()`): `"` `\` and the short forms `\t \b \n \r \f`, every other control
+/// character below U+0020 as `\u00XX` (lower-case hex), and U+2028 / U+2029 escaped. Nothing else
+/// is escaped (not `/`, not DEL, not non-ASCII).
+fn render_string(s: &str, out: &mut String) {
+    out.push('"');
+    for c in s.chars() {
+        match c {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            '\t' => out.push_str("\\t"),
+            '\u{8}' => out.push_str("\\b"),
+            '\n' => out.push_str("\\n"),
+            '\r' => out.push_str("\\r"),
+            '\u{c}' => out.push_str("\\f"),
+            '\u{2028}' => out.push_str("\\u2028"),
+            '\u{2029}' => out.push_str("\\u2029"),
+            c if (c as u32) < 0x20 => { let _ = write!(out, "\\u{:04x}", c as u32); }
+            c => out.push(c),
+        }
+    }
+    out.push('"');
+}
+
+/// Parses one JSON document (strict RFC 8259; surrounding whitespace allowed).
+pub fn parse(text: &str) -> Result<JValue, JsonError> {
+    let mut p = Parser { b: text.as_bytes(), i: 0, s: text };
+    p.ws();
+    let v = p.value(0)?;
+    p.ws();
+    if p.i != p.b.len() { return Err(JsonError::Trailing(p.i)); }
+    Ok(v)
+}
+
+struct Parser<'a> { b: &'a [u8], i: usize, s: &'a str }
+
+impl<'a> Parser<'a> {
+    fn ws(&mut self) {
+        while self.i < self.b.len() && matches!(self.b[self.i], b' ' | b'\t' | b'\n' | b'\r') { self.i += 1; }
+    }
+    fn peek(&self) -> Option<u8> { self.b.get(self.i).copied() }
+    fn expect(&mut self, c: u8) -> Result<(), JsonError> {
+        match self.peek() { Some(x) if x == c => { self.i += 1; Ok(()) } Some(_) => Err(JsonError::Unexpected(self.i)), None => Err(JsonError::Eof) }
+    }
+    fn lit(&mut self, word: &str, v: JValue) -> Result<JValue, JsonError> {
+        if self.b[self.i..].starts_with(word.as_bytes()) { self.i += word.len(); Ok(v) } else { Err(JsonError::Unexpected(self.i)) }
+    }
+    fn value(&mut self, depth: usize) -> Result<JValue, JsonError> {
+        if depth > MAX_DEPTH { return Err(JsonError::TooDeep); }
+        match self.peek().ok_or(JsonError::Eof)? {
+            b'{' => self.object(depth),
+            b'[' => self.array(depth),
+            b'"' => Ok(JValue::Str(self.string()?)),
+            b't' => self.lit("true", JValue::Bool(true)),
+            b'f' => self.lit("false", JValue::Bool(false)),
+            b'n' => self.lit("null", JValue::Null),
+            b'-' | b'0'..=b'9' => self.number(),
+            _ => Err(JsonError::Unexpected(self.i)),
+        }
+    }
+    fn object(&mut self, depth: usize) -> Result<JValue, JsonError> {
+        self.expect(b'{')?;
+        let mut members = Vec::new();
+        self.ws();
+        if self.peek() == Some(b'}') { self.i += 1; return Ok(JValue::Obj(members)); }
+        loop {
+            self.ws();
+            if self.peek() != Some(b'"') { return Err(JsonError::Unexpected(self.i)); }
+            let k = self.string()?;
+            self.ws();
+            self.expect(b':')?;
+            self.ws();
+            let v = self.value(depth + 1)?;
+            // Gson's JsonObject keeps the last value for a repeated key, at the first key's place.
+            if let Some(slot) = members.iter_mut().find(|(mk, _): &&mut (String, JValue)| *mk == k) { slot.1 = v; } else { members.push((k, v)); }
+            self.ws();
+            match self.peek().ok_or(JsonError::Eof)? {
+                b',' => { self.i += 1; }
+                b'}' => { self.i += 1; return Ok(JValue::Obj(members)); }
+                _ => return Err(JsonError::Unexpected(self.i)),
+            }
+        }
+    }
+    fn array(&mut self, depth: usize) -> Result<JValue, JsonError> {
+        self.expect(b'[')?;
+        let mut items = Vec::new();
+        self.ws();
+        if self.peek() == Some(b']') { self.i += 1; return Ok(JValue::Arr(items)); }
+        loop {
+            self.ws();
+            items.push(self.value(depth + 1)?);
+            self.ws();
+            match self.peek().ok_or(JsonError::Eof)? {
+                b',' => { self.i += 1; }
+                b']' => { self.i += 1; return Ok(JValue::Arr(items)); }
+                _ => return Err(JsonError::Unexpected(self.i)),
+            }
+        }
+    }
+    fn number(&mut self) -> Result<JValue, JsonError> {
+        let start = self.i;
+        if self.peek() == Some(b'-') { self.i += 1; }
+        match self.peek() {
+            Some(b'0') => { self.i += 1; }
+            Some(b'1'..=b'9') => { while matches!(self.peek(), Some(b'0'..=b'9')) { self.i += 1; } }
+            _ => return Err(JsonError::Unexpected(self.i)),
+        }
+        if self.peek() == Some(b'.') {
+            self.i += 1;
+            if !matches!(self.peek(), Some(b'0'..=b'9')) { return Err(JsonError::Unexpected(self.i)); }
+            while matches!(self.peek(), Some(b'0'..=b'9')) { self.i += 1; }
+        }
+        if matches!(self.peek(), Some(b'e' | b'E')) {
+            self.i += 1;
+            if matches!(self.peek(), Some(b'+' | b'-')) { self.i += 1; }
+            if !matches!(self.peek(), Some(b'0'..=b'9')) { return Err(JsonError::Unexpected(self.i)); }
+            while matches!(self.peek(), Some(b'0'..=b'9')) { self.i += 1; }
+        }
+        Ok(JValue::Num(self.s[start..self.i].to_string()))
+    }
+    fn hex4(&mut self) -> Result<u32, JsonError> {
+        if self.i + 4 > self.b.len() { return Err(JsonError::Eof); }
+        let h = std::str::from_utf8(&self.b[self.i..self.i + 4]).map_err(|_| JsonError::BadEscape(self.i))?;
+        let v = u32::from_str_radix(h, 16).map_err(|_| JsonError::BadEscape(self.i))?;
+        self.i += 4;
+        Ok(v)
+    }
+    fn string(&mut self) -> Result<String, JsonError> {
+        self.expect(b'"')?;
+        let mut out = String::new();
+        loop {
+            let start = self.i;
+            while self.i < self.b.len() && self.b[self.i] != b'"' && self.b[self.i] != b'\\' && self.b[self.i] >= 0x20 { self.i += 1; }
+            out.push_str(&self.s[start..self.i]);
+            match self.peek().ok_or(JsonError::Eof)? {
+                b'"' => { self.i += 1; return Ok(out); }
+                b'\\' => {
+                    let at = self.i;
+                    self.i += 1;
+                    let e = self.peek().ok_or(JsonError::Eof)?;
+                    self.i += 1;
+                    match e {
+                        b'"' => out.push('"'), b'\\' => out.push('\\'), b'/' => out.push('/'),
+                        b'b' => out.push('\u{8}'), b'f' => out.push('\u{c}'), b'n' => out.push('\n'),
+                        b'r' => out.push('\r'), b't' => out.push('\t'),
+                        b'u' => {
+                            let hi = self.hex4()?;
+                            let cp = if (0xD800..0xDC00).contains(&hi) {
+                                // A surrogate pair. Gson's writer never escapes surrogates, so a lone
+                                // escaped surrogate can't come from a NoSlop node; it is refused.
+                                if self.b.get(self.i) != Some(&b'\\') || self.b.get(self.i + 1) != Some(&b'u') { return Err(JsonError::BadEscape(at)); }
+                                self.i += 2;
+                                let lo = self.hex4()?;
+                                if !(0xDC00..0xE000).contains(&lo) { return Err(JsonError::BadEscape(at)); }
+                                0x10000 + ((hi - 0xD800) << 10) + (lo - 0xDC00)
+                            } else if (0xDC00..0xE000).contains(&hi) {
+                                return Err(JsonError::BadEscape(at));
+                            } else { hi };
+                            out.push(char::from_u32(cp).ok_or(JsonError::BadEscape(at))?);
+                        }
+                        _ => return Err(JsonError::BadEscape(at)),
+                    }
+                }
+                _ => return Err(JsonError::Unexpected(self.i)), // raw control character
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn round_trips_order_and_numbers() {
+        let v = parse(r#"{"b":1.50,"a":[1e3,-0,true,null],"c":{"x":"y"}}"#).unwrap();
+        assert_eq!(v.render(), r#"{"b":1.50,"a":[1e3,-0,true,null],"c":{"x":"y"}}"#);
+    }
+
+    #[test]
+    fn rejects_bad_input() {
+        assert!(parse("{\"a\":1,}").is_err());
+        assert!(parse("[01]").is_err());
+        assert!(parse("\"\\ud800\"").is_err());
+        assert!(parse("\"a\u{1}b\"").is_err());
+        assert!(parse("{} x").is_err());
+        let deep = "[".repeat(MAX_DEPTH + 2) + &"]".repeat(MAX_DEPTH + 2);
+        assert_eq!(parse(&deep), Err(JsonError::TooDeep));
+    }
+
+    #[test]
+    fn surrogate_pair_escape_decodes() {
+        assert_eq!(parse("\"\\ud83d\\ude00\"").unwrap(), JValue::Str("😀".into()));
+    }
+
+    #[test]
+    fn set_keeps_position() {
+        let mut v = JValue::obj().with("a", JValue::int(1)).with("b", JValue::int(2));
+        v.set("a", JValue::int(3));
+        assert_eq!(v.render(), r#"{"a":3,"b":2}"#);
+    }
+}
diff --git a/hainet-noslop/src/keys.rs b/hainet-noslop/src/keys.rs
new file mode 100644
index 0000000..248e90b
--- /dev/null
+++ b/hainet-noslop/src/keys.rs
@@ -0,0 +1,229 @@
+//! START OF FILE hainet-noslop/src/keys.rs
+//!
+//! NoSlop key formats, read exactly as `CryptoService.kt` reads them.
+//!
+//! * Ed25519 public: Base64 of the 44-byte X.509 SubjectPublicKeyInfo (`302a300506032b6570032100 || key`),
+//!   or a raw 32-byte key. A 48-byte value is a private key and is refused.
+//! * Ed25519 private: Base64 of the 48-byte PKCS#8 (`302e020100300506032b657004220420 || seed`), or a
+//!   raw 32/64-byte value (the first 32 bytes are the seed). A 44-byte value is a public key and is refused.
+//! * X25519 public / private: X.509 / PKCS#8 as produced by Bouncy Castle's `SubjectPublicKeyInfoFactory`
+//!   and `PrivateKeyInfoFactory` (the private form is the 83-byte v1 `OneAsymmetricKey` carrying the
+//!   public key), or raw 32 bytes.
+//!
+//! Like `CryptoService`, a structure that does not parse falls back to its last 32 bytes.
+
+use base64::{engine::general_purpose::{STANDARD, STANDARD_NO_PAD}, Engine as _};
+use ed25519_dalek::{Signer, SigningKey, Verifier, VerifyingKey, Signature};
+use sha2::{Digest as _, Sha512};
+use sha3::Sha3_256;
+
+pub const ED25519_PKCS8_HEADER: [u8; 16] = [0x30, 0x2e, 0x02, 0x01, 0x00, 0x30, 0x05, 0x06, 0x03, 0x2b, 0x65, 0x70, 0x04, 0x22, 0x04, 0x20];
+pub const ED25519_X509_HEADER: [u8; 12] = [0x30, 0x2a, 0x30, 0x05, 0x06, 0x03, 0x2b, 0x65, 0x70, 0x03, 0x21, 0x00];
+
+#[derive(Debug, thiserror::Error, PartialEq)]
+pub enum KeyError {
+    #[error("not valid Base64")]
+    Base64,
+    #[error("wrong key kind: {0}")]
+    WrongKind(&'static str),
+    #[error("key too short")]
+    TooShort,
+    #[error("invalid key")]
+    Invalid,
+}
+
+/// `android.util.Base64.decode(.., DEFAULT)`: standard alphabet, whitespace ignored, padding optional.
+pub fn b64_decode(s: &str) -> Result<Vec<u8>, KeyError> {
+    let cleaned: String = s.chars().filter(|c| !c.is_whitespace()).collect();
+    STANDARD.decode(&cleaned).or_else(|_| STANDARD_NO_PAD.decode(cleaned.trim_end_matches('='))).map_err(|_| KeyError::Base64)
+}
+
+/// `Base64.encodeToString(.., NO_WRAP)`.
+pub fn b64_encode(bytes: &[u8]) -> String { STANDARD.encode(bytes) }
+
+// --- Minimal DER reader (enough for SPKI and PKCS#8 / OneAsymmetricKey) -------------------------
+
+fn der_tlv(b: &[u8]) -> Option<(u8, &[u8], &[u8])> {
+    if b.len() < 2 { return None; }
+    let tag = b[0];
+    let (len, hdr) = if b[1] & 0x80 == 0 {
+        (b[1] as usize, 2)
+    } else {
+        let n = (b[1] & 0x7f) as usize;
+        if n == 0 || n > 2 || b.len() < 2 + n { return None; }
+        let mut l = 0usize;
+        for i in 0..n { l = (l << 8) | b[2 + i] as usize; }
+        (l, 2 + n)
+    };
+    if b.len() < hdr + len { return None; }
+    Some((tag, &b[hdr..hdr + len], &b[hdr + len..]))
+}
+
+fn der_children(content: &[u8]) -> Option<Vec<(u8, &[u8])>> {
+    let mut out = Vec::new();
+    let mut rest = content;
+    while !rest.is_empty() {
+        let (t, c, r) = der_tlv(rest)?;
+        out.push((t, c));
+        rest = r;
+    }
+    Some(out)
+}
+
+/// The raw 32-byte key of a SubjectPublicKeyInfo: `SEQUENCE { SEQUENCE alg, BIT STRING 00 || key }`.
+fn spki_raw(der: &[u8]) -> Option<[u8; 32]> {
+    let (t, c, rest) = der_tlv(der)?;
+    if t != 0x30 || !rest.is_empty() { return None; }
+    let kids = der_children(c)?;
+    if kids.len() != 2 || kids[0].0 != 0x30 || kids[1].0 != 0x03 { return None; }
+    let bits = kids[1].1;
+    if bits.len() != 33 || bits[0] != 0 { return None; }
+    bits[1..].try_into().ok()
+}
+
+/// The raw 32-byte private key of a PKCS#8 / OneAsymmetricKey:
+/// `SEQUENCE { INTEGER, SEQUENCE alg, OCTET STRING { OCTET STRING key }, ... }`.
+fn pkcs8_raw(der: &[u8]) -> Option<[u8; 32]> {
+    let (t, c, rest) = der_tlv(der)?;
+    if t != 0x30 || !rest.is_empty() { return None; }
+    let kids = der_children(c)?;
+    if kids.len() < 3 || kids[0].0 != 0x02 || kids[1].0 != 0x30 || kids[2].0 != 0x04 { return None; }
+    let (it, ic, irest) = der_tlv(kids[2].1)?;
+    if it != 0x04 || !irest.is_empty() || ic.len() != 32 { return None; }
+    ic.try_into().ok()
+}
+
+fn last32(b: &[u8]) -> Result<[u8; 32], KeyError> {
+    if b.len() < 32 { return Err(KeyError::TooShort); }
+    Ok(b[b.len() - 32..].try_into().unwrap())
+}
+
+/// Raw Ed25519 public key from NoSlop's Base64 form (`getEd25519PublicKeyParams`).
+pub fn ed25519_public_raw(b64: &str) -> Result<[u8; 32], KeyError> {
+    let b = b64_decode(b64)?;
+    if b.len() == 48 { return Err(KeyError::WrongKind("48-byte PKCS#8 private key given as a public key")); }
+    if b.len() == 32 { return Ok(b.try_into().unwrap()); }
+    spki_raw(&b).map(Ok).unwrap_or_else(|| last32(&b))
+}
+
+/// Raw Ed25519 seed from NoSlop's Base64 form (`getEd25519PrivateKeyParams`).
+pub fn ed25519_seed(b64: &str) -> Result<[u8; 32], KeyError> {
+    let b = b64_decode(b64)?;
+    if b.len() == 44 { return Err(KeyError::WrongKind("44-byte X.509 public key given as a private key")); }
+    if b.len() == 32 || b.len() == 64 { return Ok(b[..32].try_into().unwrap()); }
+    pkcs8_raw(&b).map(Ok).unwrap_or_else(|| last32(&b))
+}
+
+/// Raw X25519 public key (`getX25519PublicKeyParams`).
+pub fn x25519_public_raw(b64: &str) -> Result<[u8; 32], KeyError> {
+    let b = b64_decode(b64)?;
+    if b.len() == 32 { return Ok(b.try_into().unwrap()); }
+    spki_raw(&b).map(Ok).unwrap_or_else(|| last32(&b))
+}
+
+/// Raw X25519 private key (`getX25519PrivateKeyParams`).
+pub fn x25519_private_raw(b64: &str) -> Result<[u8; 32], KeyError> {
+    let b = b64_decode(b64)?;
+    if b.len() == 32 { return Ok(b.try_into().unwrap()); }
+    pkcs8_raw(&b).map(Ok).unwrap_or_else(|| last32(&b))
+}
+
+/// NoSlop's Base64 public key string for a raw Ed25519 key (X.509 wrapped).
+pub fn ed25519_public_b64(raw: &[u8; 32]) -> String {
+    let mut v = ED25519_X509_HEADER.to_vec();
+    v.extend_from_slice(raw);
+    b64_encode(&v)
+}
+
+/// `CryptoService.deriveOnionAddress`: the Tor v3 address of an Ed25519 key.
+pub fn onion_of_raw(raw: &[u8; 32]) -> String {
+    let mut h = Sha3_256::new();
+    h.update(b".onion checksum");
+    h.update(raw);
+    h.update([0x03u8]);
+    let hash = h.finalize();
+    let mut data = Vec::with_capacity(35);
+    data.extend_from_slice(raw);
+    data.extend_from_slice(&hash[..2]);
+    data.push(0x03);
+    format!("{}.onion", base32::encode(base32::Alphabet::Rfc4648 { padding: false }, &data).to_lowercase())
+}
+
+/// The onion of a NoSlop Base64 public key, or `None` when the key can't be read (`onionOf`).
+pub fn onion_of(pub_b64: &str) -> Option<String> { ed25519_public_raw(pub_b64).ok().map(|r| onion_of_raw(&r)) }
+
+/// `CryptoService.isOnionOf` (case-insensitive, trimmed).
+pub fn is_onion_of(pub_b64: &str, onion: &str) -> bool {
+    onion_of(pub_b64).map(|o| o.eq_ignore_ascii_case(onion.trim())).unwrap_or(false)
+}
+
+/// Tor's `hs_ed25519_secret_key` body for a seed: SHA-512(seed), clamped (`getRawEd25519Seed`).
+pub fn tor_expanded_secret(seed: &[u8; 32]) -> [u8; 64] {
+    let mut e: [u8; 64] = Sha512::digest(seed).into();
+    e[0] &= 248;
+    e[31] &= 127;
+    e[31] |= 64;
+    e
+}
+
+/// The file Tor reads from a `HiddenServiceDir` (`hs_ed25519_secret_key`).
+pub fn tor_secret_key_file(seed: &[u8; 32]) -> Vec<u8> {
+    let mut v = b"== ed25519v1-secret: type0 ==\0\0\0".to_vec();
+    v.extend_from_slice(&tor_expanded_secret(seed));
+    v
+}
+
+/// `CryptoService.verify`: Ed25519 over the UTF-8 bytes of `payload`. Never panics.
+pub fn verify(payload: &str, signature_b64: &str, pub_b64: &str) -> bool {
+    let Ok(raw) = ed25519_public_raw(pub_b64) else { return false };
+    let Ok(vk) = VerifyingKey::from_bytes(&raw) else { return false };
+    let Ok(sig_bytes) = b64_decode(signature_b64) else { return false };
+    let Ok(sig) = Signature::from_slice(&sig_bytes) else { return false };
+    vk.verify(payload.as_bytes(), &sig).is_ok()
+}
+
+/// One NoSlop identity as held by the Hub (the owner's personal or creator identity).
+#[derive(Clone)]
+pub struct Identity {
+    signing: SigningKey,
+    /// The exact Base64 public key string the phone uses as `sender_id` (X.509 wrapped).
+    pub public_key_b64: String,
+    pub onion: String,
+    /// X25519 keys in the phone's Base64 form (as given by the phone).
+    pub enc_public_key_b64: String,
+    enc_private_raw: [u8; 32],
+}
+
+impl std::fmt::Debug for Identity {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("Identity").field("public_key_b64", &self.public_key_b64).field("onion", &self.onion).finish_non_exhaustive()
+    }
+}
+
+impl Identity {
+    /// Builds an identity from the phone's Base64 key strings, checking that the private keys match
+    /// the public ones (a mismatch would publish an onion nobody can reach).
+    pub fn from_b64(public_key_b64: &str, private_key_b64: &str, enc_public_key_b64: &str, enc_private_key_b64: &str) -> Result<Self, KeyError> {
+        let seed = ed25519_seed(private_key_b64)?;
+        let signing = SigningKey::from_bytes(&seed);
+        let raw_pub = ed25519_public_raw(public_key_b64)?;
+        if signing.verifying_key().to_bytes() != raw_pub { return Err(KeyError::Invalid); }
+        let enc_private_raw = x25519_private_raw(enc_private_key_b64)?;
+        let derived_x = x25519_dalek::PublicKey::from(&x25519_dalek::StaticSecret::from(enc_private_raw));
+        if derived_x.to_bytes() != x25519_public_raw(enc_public_key_b64)? { return Err(KeyError::Invalid); }
+        Ok(Self {
+            signing,
+            public_key_b64: public_key_b64.trim().to_string(),
+            onion: onion_of_raw(&raw_pub),
+            enc_public_key_b64: enc_public_key_b64.trim().to_string(),
+            enc_private_raw,
+        })
+    }
+
+    pub fn seed(&self) -> [u8; 32] { self.signing.to_bytes() }
+
+    /// `CryptoService.sign`: Base64 Ed25519 signature over the UTF-8 bytes of `payload`.
+    pub fn sign(&self, payload: &str) -> String { b64_encode(&self.signing.sign(payload.as_bytes()).to_bytes()) }
+
+    pub fn x25519_secret(&self) -> x25519_dalek::StaticSecret { x25519_dalek::StaticSecret::from(self.enc_private_raw) }
+}
