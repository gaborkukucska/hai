+//! START OF FILE hainet-noslop/src/lib.rs
+//!
+//! # hainet-noslop
+//!
+//! The NoSlop mesh protocol as the HAI-Net Home HUB needs it, matched byte for byte to the legacy
+//! Android app (NoSlop 0.8.x, `com.noslop.app.mesh` / `com.noslop.app.crypto`):
+//!
+//! * [`json`]: order-preserving JSON rendered exactly like Gson (for the envelope digest).
+//! * [`canon`]: `encodeForSigning` (UTF-16 lengths) and every canonical signed string the Hub uses.
+//! * [`keys`]: X.509 / PKCS#8 / raw key formats, onion derivation, Tor secret key file, signing.
+//! * [`packet`] and [`envelope`]: `NetworkPacket` and the `noslop-env-v1` envelope signature.
+//! * [`dm`]: DM v2 (directional HKDF + AAD) and legacy v1 decryption.
+//! * `hub` (feature `hub`): the Home HUB node that hosts the owner's creator identity, keeps a durable
+//!   inbox for the phone, and serves the owner's control API.
+//!
+//! Every format is checked against vectors produced by the app's own libraries (Gson 2.10,
+//! Bouncy Castle 1.78.1): `tests/vectors/noslop_vectors.json`, generator in `tests/vector-generator/`.
+
+pub mod canon;
+pub mod dm;
+pub mod envelope;
+pub mod json;
+pub mod keys;
+pub mod packet;
+
+#[cfg(feature = "hub")]
+pub mod hub;
diff --git a/hainet-noslop/src/packet.rs b/hainet-noslop/src/packet.rs
new file mode 100644
index 0000000..d0e08a0
--- /dev/null
+++ b/hainet-noslop/src/packet.rs
@@ -0,0 +1,119 @@
+//! START OF FILE hainet-noslop/src/packet.rs
+//!
+//! `NetworkPacket` (`mesh/Packets.kt`) with its payload kept as an order-preserving [`JValue`], so
+//! the envelope digest of a received packet can be reproduced and a relayed packet is passed on
+//! byte-for-byte equivalent.
+
+use crate::json::{self, JValue, JsonError};
+
+/// Frame ceiling for one newline-delimited packet. The phone's listener uses the same order of
+/// magnitude (`FrameReader.maxChars`); a 256 KB media chunk is ~350 KB as Base64 inside JSON.
+pub const MAX_FRAME_BYTES: usize = 1024 * 1024;
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct Packet {
+    pub id: Option<String>,
+    pub hops: Option<i64>,
+    pub sender_id: String,
+    pub target_user_id: Option<String>,
+    pub signature: Option<String>,
+    pub ptype: String,
+    pub payload: Option<JValue>,
+    pub env_v: Option<i64>,
+    pub env_ts: Option<i64>,
+    pub env_sig: Option<String>,
+}
+
+#[derive(Debug, thiserror::Error)]
+pub enum PacketError {
+    #[error("json: {0}")]
+    Json(#[from] JsonError),
+    #[error("packet is not a JSON object")]
+    NotObject,
+    #[error("missing or invalid field {0}")]
+    Field(&'static str),
+    #[error("frame too large")]
+    TooLarge,
+}
+
+fn opt_str(v: &JValue, k: &'static str) -> Result<Option<String>, PacketError> {
+    match v.get(k) {
+        None | Some(JValue::Null) => Ok(None),
+        Some(JValue::Str(s)) => Ok(Some(s.clone())),
+        _ => Err(PacketError::Field(k)),
+    }
+}
+
+fn opt_int(v: &JValue, k: &'static str) -> Result<Option<i64>, PacketError> {
+    match v.get(k) {
+        None | Some(JValue::Null) => Ok(None),
+        Some(n @ JValue::Num(_)) => n.as_i64().map(Some).ok_or(PacketError::Field(k)),
+        _ => Err(PacketError::Field(k)),
+    }
+}
+
+impl Packet {
+    /// A new packet with no envelope (sign it with [`crate::envelope::sign`] before sending).
+    pub fn new(ptype: &str, sender_id: &str, target: Option<&str>, payload: JValue, hops: i64) -> Self {
+        Packet {
+            id: Some(uuid::Uuid::new_v4().to_string()),
+            hops: Some(hops),
+            sender_id: sender_id.to_string(),
+            target_user_id: target.map(|t| t.to_string()),
+            signature: None,
+            ptype: ptype.to_string(),
+            payload: Some(payload),
+            env_v: None,
+            env_ts: None,
+            env_sig: None,
+        }
+    }
+
+    /// Parses one frame as Gson would read it into `NetworkPacket`. `sender_id` and `type` are required.
+    pub fn from_wire(frame: &str) -> Result<Self, PacketError> {
+        if frame.len() > MAX_FRAME_BYTES { return Err(PacketError::TooLarge); }
+        let v = json::parse(frame)?;
+        Self::from_value(&v)
+    }
+
+    pub fn from_value(v: &JValue) -> Result<Self, PacketError> {
+        if !matches!(v, JValue::Obj(_)) { return Err(PacketError::NotObject); }
+        let sender_id = opt_str(v, "sender_id")?.ok_or(PacketError::Field("sender_id"))?;
+        let ptype = opt_str(v, "type")?.ok_or(PacketError::Field("type"))?;
+        let payload = match v.get("payload") { None | Some(JValue::Null) => None, Some(p) => Some(p.clone()) };
+        Ok(Packet {
+            id: opt_str(v, "id")?,
+            hops: opt_int(v, "hops")?,
+            sender_id,
+            target_user_id: opt_str(v, "target_user_id")?,
+            signature: opt_str(v, "signature")?,
+            ptype,
+            payload,
+            env_v: opt_int(v, "env_v")?,
+            env_ts: opt_int(v, "env_ts")?,
+            env_sig: opt_str(v, "env_sig")?,
+        })
+    }
+
+    /// Gson's rendering of the packet (field declaration order, nulls left out).
+    pub fn to_value(&self) -> JValue {
+        JValue::obj()
+            .with_opt("id", self.id.clone().map(JValue::Str))
+            .with_opt("hops", self.hops.map(JValue::int))
+            .with("sender_id", JValue::str(&self.sender_id))
+            .with_opt("target_user_id", self.target_user_id.clone().map(JValue::Str))
+            .with_opt("signature", self.signature.clone().map(JValue::Str))
+            .with("type", JValue::str(&self.ptype))
+            .with_opt("payload", self.payload.clone())
+            .with_opt("env_v", self.env_v.map(JValue::int))
+            .with_opt("env_ts", self.env_ts.map(JValue::int))
+            .with_opt("env_sig", self.env_sig.clone().map(JValue::Str))
+    }
+
+    pub fn to_wire(&self) -> String { self.to_value().render() }
+
+    /// Payload member as a string (`None` for absent or null).
+    pub fn p_str(&self, key: &str) -> Option<&str> { self.payload.as_ref().and_then(|p| p.get_str(key)) }
+    pub fn p_i64(&self, key: &str) -> Option<i64> { self.payload.as_ref().and_then(|p| p.get_i64(key)) }
+    pub fn p(&self, key: &str) -> Option<&JValue> { self.payload.as_ref().and_then(|p| p.get(key)) }
+}
diff --git a/hainet-noslop/tests/vector-generator/GenVectors.java b/hainet-noslop/tests/vector-generator/GenVectors.java
new file mode 100644
index 0000000..46b098c
--- /dev/null
+++ b/hainet-noslop/tests/vector-generator/GenVectors.java
@@ -0,0 +1,155 @@
+// Generates cross-language test vectors for hainet-noslop by running the SAME libraries the NoSlop
+// Android app uses (Gson + BouncyCastle) through code that mirrors the Kotlin functions line by line:
+// CryptoService.encodeForSigning / sign / deriveOnionAddress / getRawEd25519Seed / deriveDirectionalKeyV2 /
+// canonicalDmAadV2 / encryptDMV2, EnvelopeAuth.payloadDigest / signingString,
+// MediaManager.mediaRequestSigningString, canonicalHandshakePayloadV2, canonicalAnnouncePeerV2.
+import com.google.gson.*;
+import org.bouncycastle.crypto.params.*;
+import org.bouncycastle.crypto.signers.Ed25519Signer;
+import org.bouncycastle.crypto.util.*;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.*;
+
+public class GenVectors {
+    static final byte[] PKCS8 = {0x30,0x2e,0x02,0x01,0x00,0x30,0x05,0x06,0x03,0x2b,0x65,0x70,0x04,0x22,0x04,0x20};
+    static final byte[] X509 = {0x30,0x2a,0x30,0x05,0x06,0x03,0x2b,0x65,0x70,0x03,0x21,0x00};
+    static Base64.Encoder B64 = Base64.getEncoder();
+
+    static String encodeForSigning(String... parts) {
+        StringBuilder sb = new StringBuilder();
+        for (String p : parts) { if (p == null) sb.append("0:"); else sb.append(p.length()).append(':').append(p); }
+        return sb.toString();
+    }
+    static byte[] cat(byte[] a, byte[] b) { byte[] r = Arrays.copyOf(a, a.length + b.length); System.arraycopy(b, 0, r, a.length, b.length); return r; }
+    static String hex(byte[] d) { StringBuilder sb = new StringBuilder(); for (byte b : d) sb.append(String.format("%02x", b & 0xff)); return sb.toString(); }
+    static String sha256Hex(String s) throws Exception { return hex(MessageDigest.getInstance("SHA-256").digest(s.getBytes(StandardCharsets.UTF_8))); }
+
+    static JsonElement withoutNullMembers(JsonElement e) {
+        if (e.isJsonObject()) { JsonObject o = new JsonObject(); for (Map.Entry<String, JsonElement> en : e.getAsJsonObject().entrySet()) if (!en.getValue().isJsonNull()) o.add(en.getKey(), withoutNullMembers(en.getValue())); return o; }
+        if (e.isJsonArray()) { JsonArray a = new JsonArray(); for (JsonElement v : e.getAsJsonArray()) a.add(withoutNullMembers(v)); return a; }
+        return e;
+    }
+    static String rendered(JsonElement payload) { return (payload == null || payload.isJsonNull()) ? "" : withoutNullMembers(payload).toString(); }
+
+    static String sign(String payload, byte[] seed) {
+        Ed25519Signer s = new Ed25519Signer(); s.init(true, new Ed25519PrivateKeyParameters(seed, 0));
+        byte[] m = payload.getBytes(StandardCharsets.UTF_8); s.update(m, 0, m.length); return B64.encodeToString(s.generateSignature());
+    }
+    static String base32(byte[] bytes) { // CryptoService.base32 (RFC 4648 lower-case, no padding)
+        String alpha = "abcdefghijklmnopqrstuvwxyz234567"; StringBuilder sb = new StringBuilder(); int buffer = 0, bits = 0;
+        for (byte b : bytes) { buffer = (buffer << 8) | (b & 0xff); bits += 8; while (bits >= 5) { sb.append(alpha.charAt((buffer >> (bits - 5)) & 31)); bits -= 5; } }
+        if (bits > 0) sb.append(alpha.charAt((buffer << (5 - bits)) & 31)); return sb.toString();
+    }
+    static String onion(byte[] rawPub) {
+        org.bouncycastle.crypto.digests.SHA3Digest d = new org.bouncycastle.crypto.digests.SHA3Digest(256);
+        byte[] in = cat(cat(".onion checksum".getBytes(StandardCharsets.UTF_8), rawPub), new byte[]{3});
+        byte[] h = new byte[32]; d.update(in, 0, in.length); d.doFinal(h, 0);
+        String enc = base32(cat(cat(rawPub, new byte[]{h[0], h[1]}), new byte[]{3}));
+        while (enc.length() < 56) enc += "a"; return enc.substring(0, 56) + ".onion";
+    }
+
+    public static void main(String[] a) throws Exception {
+        JsonObject out = new JsonObject();
+
+        // --- encodeForSigning (UTF-16 lengths) ---
+        JsonArray efs = new JsonArray();
+        String[][] cases = { {"noslop-env-v1", "", "abc"}, {"héllo", "😀x", null, "日本"}, {"", null, ""} };
+        for (String[] c : cases) {
+            JsonObject v = new JsonObject(); JsonArray parts = new JsonArray();
+            for (String p : c) parts.add(p == null ? JsonNull.INSTANCE : new JsonPrimitive(p));
+            v.add("parts", parts); v.addProperty("encoded", encodeForSigning(c)); efs.add(v);
+        }
+        out.add("encode_for_signing", efs);
+
+        // --- payload rendering / digest, as a RECEIVER sees it (parse wire text, then render) ---
+        String[] wires = {
+            "{\"a\":1,\"b\":null,\"c\":[1,null,{\"d\":null,\"e\":\"x\"}],\"z\":{}}",
+            "{\"s\":\"quote\\\" back\\\\ nl\\n tab\\t cr\\r bs\\b ff\\f nul\\u0000 us\\u001f del\\u007f\"}",
+            "{\"u\":\"ls\\u2028 ps\\u2029 emoji😀 é <html>&='\",\"slash\":\"a/b\\/c\"}",
+            "{\"n1\":1700000000000,\"n2\":-5,\"n3\":1.50,\"n4\":1e3,\"n5\":0,\"t\":true,\"f\":false}",
+            "{\"author_avatar_b64\":\"QUJD+/==\",\"empty\":\"\",\"arr\":[],\"nested\":{\"x\":[[null]]}}",
+            "[]", "\"just a string\"", "null"
+        };
+        JsonArray rd = new JsonArray();
+        for (String w : wires) {
+            JsonElement parsed = JsonParser.parseString(w);
+            JsonObject v = new JsonObject(); v.addProperty("wire", w);
+            v.addProperty("rendered", rendered(parsed)); v.addProperty("digest", sha256Hex(rendered(parsed)));
+            rd.add(v);
+        }
+        out.add("payload_digest", rd);
+
+        // --- Identity from a fixed seed (deterministic) ---
+        byte[] seed = new byte[32]; for (int i = 0; i < 32; i++) seed[i] = (byte) (i * 7 + 3);
+        Ed25519PrivateKeyParameters priv = new Ed25519PrivateKeyParameters(seed, 0);
+        byte[] rawPub = priv.generatePublicKey().getEncoded();
+        String pubB64 = B64.encodeToString(cat(X509, rawPub)), privB64 = B64.encodeToString(cat(PKCS8, seed));
+        byte[] xseed = new byte[32]; for (int i = 0; i < 32; i++) xseed[i] = (byte) (255 - i * 3);
+        X25519PrivateKeyParameters xpriv = new X25519PrivateKeyParameters(xseed, 0);
+        String xPubB64 = B64.encodeToString(SubjectPublicKeyInfoFactory.createSubjectPublicKeyInfo(xpriv.generatePublicKey()).getEncoded());
+        String xPrivB64 = B64.encodeToString(PrivateKeyInfoFactory.createPrivateKeyInfo(xpriv).getEncoded());
+        JsonObject id = new JsonObject();
+        id.addProperty("seed_hex", hex(seed)); id.addProperty("public_key_b64", pubB64); id.addProperty("private_key_b64", privB64);
+        id.addProperty("onion", onion(rawPub)); id.addProperty("enc_public_key_b64", xPubB64); id.addProperty("enc_private_key_b64", xPrivB64);
+        // getRawEd25519Seed: Tor ADD_ONION expanded secret (SHA-512 + clamp)
+        byte[] exp = MessageDigest.getInstance("SHA-512").digest(seed);
+        exp[0] &= (byte) 248; exp[31] &= (byte) 127; exp[31] |= (byte) 64;
+        id.addProperty("tor_expanded_b64", B64.encodeToString(exp));
+        out.add("identity", id);
+
+        // --- Envelope: sign a packet exactly as EnvelopeAuth.sign does ---
+        Gson gson = new Gson();
+        JsonObject payload = new JsonObject();
+        payload.addProperty("author_id", pubB64); payload.addProperty("onion_address", onion(rawPub));
+        payload.addProperty("timestamp", 1763700000000L); payload.addProperty("signature", "c2ln");
+        String envSigning = encodeForSigning("noslop-env-v1", "pkt-1", "ANNOUNCE_PEER", pubB64, "", "c2ln", "1763700000123", sha256Hex(rendered(payload)));
+        JsonObject pkt = new JsonObject();
+        pkt.addProperty("id", "pkt-1"); pkt.addProperty("hops", 3); pkt.addProperty("sender_id", pubB64);
+        pkt.addProperty("signature", "c2ln"); pkt.addProperty("type", "ANNOUNCE_PEER"); pkt.add("payload", payload);
+        pkt.addProperty("env_v", 1); pkt.addProperty("env_ts", 1763700000123L); pkt.addProperty("env_sig", sign(envSigning, seed));
+        JsonObject env = new JsonObject(); env.addProperty("signing_string", envSigning); env.addProperty("packet_wire", gson.toJson(pkt));
+        out.add("envelope", env);
+
+        // --- Other canonical strings ---
+        JsonObject canon = new JsonObject();
+        canon.addProperty("announce_v2", encodeForSigning("noslop-announce-v2", pubB64, onion(rawPub), "1763700000000"));
+        canon.addProperty("announce_v2_sig", sign(encodeForSigning("noslop-announce-v2", pubB64, onion(rawPub), "1763700000000"), seed));
+        String hs = encodeForSigning("noslop-hs-v2", pubB64, "Alice.abc12345", onion(rawPub), xPubB64, "TARGETKEY", "nonce123", "1763700000000", null, "bio 😀");
+        canon.addProperty("handshake_v2", hs); canon.addProperty("handshake_v2_sig", sign(hs, seed));
+        String mr = encodeForSigning("noslop-media-req-v1", pubB64, "TARGETKEY", "media_1", "0", "262144", "0", "262144", "1763700000000");
+        canon.addProperty("media_req", mr); canon.addProperty("media_req_sig", sign(mr, seed));
+        String disc = pubB64 + ":Creator.abc:" + onion(rawPub) + ":" + xPubB64 + ":true:https://x.y/z::my bio:1763700000000";
+        canon.addProperty("discoverable", disc); canon.addProperty("discoverable_sig", sign(disc, seed));
+        out.add("canonical", canon);
+
+        // --- DM v2 with a fixed IV (directional HKDF + AAD), second party from another seed ---
+        byte[] yseed = new byte[32]; for (int i = 0; i < 32; i++) yseed[i] = (byte) (i * 11 + 1);
+        X25519PrivateKeyParameters ypriv = new X25519PrivateKeyParameters(yseed, 0);
+        String yPubB64 = B64.encodeToString(SubjectPublicKeyInfoFactory.createSubjectPublicKeyInfo(ypriv.generatePublicKey()).getEncoded());
+        String yPrivB64 = B64.encodeToString(PrivateKeyInfoFactory.createPrivateKeyInfo(ypriv).getEncoded());
+        org.bouncycastle.crypto.agreement.X25519Agreement ag = new org.bouncycastle.crypto.agreement.X25519Agreement();
+        ag.init(xpriv); byte[] shared = new byte[32]; ag.calculateAgreement(ypriv.generatePublicKey(), shared, 0);
+        String senderEd = pubB64, recipientEd = "admin_" + pubB64;
+        String s1 = senderEd.compareTo(recipientEd) <= 0 ? senderEd : recipientEd, s2 = senderEd.compareTo(recipientEd) <= 0 ? recipientEd : senderEd;
+        MessageDigest sd = MessageDigest.getInstance("SHA-256"); sd.update(s1.getBytes(StandardCharsets.UTF_8)); sd.update(s2.getBytes(StandardCharsets.UTF_8)); byte[] salt = sd.digest();
+        org.bouncycastle.crypto.generators.HKDFBytesGenerator hk = new org.bouncycastle.crypto.generators.HKDFBytesGenerator(new org.bouncycastle.crypto.digests.SHA256Digest());
+        hk.init(new HKDFParameters(shared, salt, ("noslop-dm-v2|" + senderEd + "->" + recipientEd).getBytes(StandardCharsets.UTF_8)));
+        byte[] kdir = new byte[32]; hk.generateBytes(kdir, 0, 32);
+        byte[] iv = new byte[12]; for (int i = 0; i < 12; i++) iv[i] = (byte) (i + 100);
+        String aad = encodeForSigning("noslop-dm-v2", senderEd, recipientEd, "msg-1", "", "1763700000000");
+        org.bouncycastle.crypto.modes.ChaCha20Poly1305 cc = new org.bouncycastle.crypto.modes.ChaCha20Poly1305();
+        cc.init(true, new AEADParameters(new KeyParameter(kdir), 128, iv, aad.getBytes(StandardCharsets.UTF_8)));
+        byte[] pt = "{\"content\":\"hi 😀\"}".getBytes(StandardCharsets.UTF_8);
+        byte[] ct = new byte[cc.getOutputSize(pt.length)]; int l = cc.processBytes(pt, 0, pt.length, ct, 0); cc.doFinal(ct, l);
+        JsonObject dm = new JsonObject();
+        dm.addProperty("sender_enc_priv_b64", xPrivB64); dm.addProperty("recipient_enc_pub_b64", yPubB64); dm.addProperty("recipient_enc_priv_b64", yPrivB64);
+        dm.addProperty("sender_enc_pub_b64", xPubB64); dm.addProperty("sender_ed", senderEd); dm.addProperty("recipient_ed", recipientEd);
+        dm.addProperty("msg_id", "msg-1"); dm.addProperty("timestamp", 1763700000000L); dm.addProperty("aad", aad);
+        dm.addProperty("key_hex", hex(kdir)); dm.addProperty("iv_b64", B64.encodeToString(iv)); dm.addProperty("plaintext", new String(pt, StandardCharsets.UTF_8));
+        dm.addProperty("ciphertext_b64", B64.encodeToString(ct));
+        out.add("dm_v2", dm);
+
+        System.out.println(new GsonBuilder().setPrettyPrinting().disableHtmlEscaping().create().toJson(out));
+    }
+}
diff --git a/hainet-noslop/tests/vectors.rs b/hainet-noslop/tests/vectors.rs
new file mode 100644
index 0000000..dc56122
--- /dev/null
+++ b/hainet-noslop/tests/vectors.rs
@@ -0,0 +1,146 @@
+//! START OF FILE hainet-noslop/tests/vectors.rs
+//!
+//! Cross-language checks: every value here was produced by the NoSlop app's own libraries (Gson 2.10,
+//! Bouncy Castle 1.78.1) running code that mirrors the Kotlin functions (`tests/vector-generator/GenVectors.java`).
+//! If one of these fails, the Hub and the phone disagree on the wire.
+
+use hainet_noslop::{canon, dm, envelope, json, keys, packet::Packet};
+
+fn vectors() -> serde_json::Value {
+    serde_json::from_str(include_str!("vectors/noslop_vectors.json")).unwrap()
+}
+fn s<'a>(v: &'a serde_json::Value, k: &str) -> &'a str { v[k].as_str().unwrap() }
+
+#[test]
+fn encode_for_signing_matches_kotlin() {
+    for case in vectors()["encode_for_signing"].as_array().unwrap() {
+        let parts: Vec<Option<String>> = case["parts"].as_array().unwrap().iter().map(|p| p.as_str().map(|x| x.to_string())).collect();
+        let refs: Vec<Option<&str>> = parts.iter().map(|p| p.as_deref()).collect();
+        assert_eq!(canon::encode_for_signing(&refs), s(case, "encoded"));
+    }
+}
+
+#[test]
+fn payload_rendering_and_digest_match_gson() {
+    for case in vectors()["payload_digest"].as_array().unwrap() {
+        let parsed = json::parse(s(case, "wire")).unwrap();
+        let payload = if parsed.is_null() { None } else { Some(&parsed) };
+        let rendered = match payload { None => String::new(), Some(p) => p.without_null_members().render() };
+        assert_eq!(rendered, s(case, "rendered"), "wire {}", s(case, "wire"));
+        assert_eq!(envelope::payload_digest(payload), s(case, "digest"));
+    }
+}
+
+#[test]
+fn identity_formats_match_bouncy_castle() {
+    let v = vectors();
+    let id = &v["identity"];
+    let seed = hex::decode(s(id, "seed_hex")).unwrap();
+    assert_eq!(keys::ed25519_seed(s(id, "private_key_b64")).unwrap().to_vec(), seed);
+    let raw = keys::ed25519_public_raw(s(id, "public_key_b64")).unwrap();
+    assert_eq!(keys::ed25519_public_b64(&raw), s(id, "public_key_b64"));
+    assert_eq!(keys::onion_of(s(id, "public_key_b64")).unwrap(), s(id, "onion"));
+    assert!(keys::is_onion_of(s(id, "public_key_b64"), &s(id, "onion").to_uppercase()));
+    let seed32: [u8; 32] = seed.try_into().unwrap();
+    assert_eq!(keys::b64_encode(&keys::tor_expanded_secret(&seed32)), s(id, "tor_expanded_b64"));
+    // The 83-byte BC X25519 private key (v1 OneAsymmetricKey with the public key) is read correctly.
+    let ident = keys::Identity::from_b64(s(id, "public_key_b64"), s(id, "private_key_b64"), s(id, "enc_public_key_b64"), s(id, "enc_private_key_b64")).unwrap();
+    assert_eq!(ident.onion, s(id, "onion"));
+    // Wrong kinds are refused, as CryptoService does.
+    assert!(keys::ed25519_seed(s(id, "public_key_b64")).is_err());
+    assert!(keys::ed25519_public_raw(s(id, "private_key_b64")).is_err());
+    // A mismatched X25519 pair is refused.
+    assert!(keys::Identity::from_b64(s(id, "public_key_b64"), s(id, "private_key_b64"), s(&v["dm_v2"], "recipient_enc_pub_b64"), s(id, "enc_private_key_b64")).is_err());
+}
+
+#[test]
+fn envelope_verifies_and_resigns_identically() {
+    let v = vectors();
+    let id = &v["identity"];
+    let ident = keys::Identity::from_b64(s(id, "public_key_b64"), s(id, "private_key_b64"), s(id, "enc_public_key_b64"), s(id, "enc_private_key_b64")).unwrap();
+    let pkt = Packet::from_wire(s(&v["envelope"], "packet_wire")).unwrap();
+    let ts = pkt.env_ts.unwrap();
+    assert_eq!(envelope::signing_string(&pkt, ts), s(&v["envelope"], "signing_string"));
+    assert_eq!(envelope::verify(&pkt, ts + 1000), envelope::Verdict::Valid);
+    assert_eq!(envelope::verify(&pkt, ts + envelope::MAX_SKEW_MS + 1), envelope::Verdict::Stale);
+    // Ed25519 is deterministic: re-signing gives the same signature as Bouncy Castle.
+    let resigned = envelope::sign(&pkt, &ident, ts).unwrap();
+    assert_eq!(resigned.env_sig, pkt.env_sig);
+    // hops is not covered; the payload is.
+    let mut hopped = pkt.clone();
+    hopped.hops = Some(1);
+    assert_eq!(envelope::verify(&hopped, ts), envelope::Verdict::Valid);
+    let mut tampered = pkt.clone();
+    tampered.payload.as_mut().unwrap().set("timestamp", json::JValue::int(1));
+    assert_eq!(envelope::verify(&tampered, ts), envelope::Verdict::Invalid);
+    let mut bare = pkt.clone();
+    bare.env_sig = None;
+    assert_eq!(envelope::verify(&bare, ts), envelope::Verdict::Missing);
+    // Wire round trip keeps the verifiable form.
+    let again = Packet::from_wire(&pkt.to_wire()).unwrap();
+    assert_eq!(envelope::verify(&again, ts), envelope::Verdict::Valid);
+    // Replay guard.
+    let mut g = envelope::ReplayGuard::new(10);
+    assert!(g.admit(&pkt, ts));
+    assert!(!g.admit(&pkt, ts + 5));
+}
+
+#[test]
+fn canonical_strings_and_signatures_match() {
+    let v = vectors();
+    let id = &v["identity"];
+    let c = &v["canonical"];
+    let ident = keys::Identity::from_b64(s(id, "public_key_b64"), s(id, "private_key_b64"), s(id, "enc_public_key_b64"), s(id, "enc_private_key_b64")).unwrap();
+    let pubk = s(id, "public_key_b64");
+    let onion = s(id, "onion");
+    let a = canon::announce_peer_v2(pubk, Some(onion), 1763700000000);
+    assert_eq!(a, s(c, "announce_v2"));
+    assert_eq!(ident.sign(&a), s(c, "announce_v2_sig"));
+    let hs = canon::handshake_v2(pubk, "Alice.abc12345", onion, s(id, "enc_public_key_b64"), "TARGETKEY", "nonce123", 1763700000000, None, Some("bio 😀"), None);
+    assert_eq!(hs, s(c, "handshake_v2"));
+    assert!(keys::verify(&hs, s(c, "handshake_v2_sig"), pubk));
+    let mr = canon::media_request(pubk, Some("TARGETKEY"), "media_1", 0, 262144, Some(0), Some(262144), Some(1763700000000));
+    assert_eq!(mr, s(c, "media_req"));
+    assert!(keys::verify(&mr, s(c, "media_req_sig"), pubk));
+    let d = canon::discoverable(pubk, "Creator.abc", onion, s(id, "enc_public_key_b64"), true, Some("https://x.y/z"), None, Some("my bio"), 1763700000000);
+    assert_eq!(d, s(c, "discoverable"));
+    assert_eq!(ident.sign(&d), s(c, "discoverable_sig"));
+}
+
+#[test]
+fn dm_v2_matches_kotlin() {
+    let v = vectors();
+    let d = &v["dm_v2"];
+    let sender_priv = x25519_dalek::StaticSecret::from(keys::x25519_private_raw(s(d, "sender_enc_priv_b64")).unwrap());
+    let recip_priv = x25519_dalek::StaticSecret::from(keys::x25519_private_raw(s(d, "recipient_enc_priv_b64")).unwrap());
+    let iv: [u8; 12] = keys::b64_decode(s(d, "iv_b64")).unwrap().try_into().unwrap();
+    let ts = d["timestamp"].as_i64().unwrap();
+    assert_eq!(dm::aad_v2(dm::DM_AAD_MESSAGE, s(d, "sender_ed"), s(d, "recipient_ed"), s(d, "msg_id"), None, ts), s(d, "aad"));
+    let (ct, _) = dm::encrypt_v2_with_iv(s(d, "plaintext"), s(d, "recipient_enc_pub_b64"), &sender_priv, s(d, "sender_ed"), s(d, "recipient_ed"), s(d, "msg_id"), None, ts, dm::DM_AAD_MESSAGE, iv).unwrap();
+    assert_eq!(ct, s(d, "ciphertext_b64"));
+    // The recipient opens it with its own key and the sender's public key.
+    let pt = dm::decrypt_v2(&ct, s(d, "iv_b64"), s(d, "sender_enc_pub_b64"), &recip_priv, s(d, "sender_ed"), s(d, "recipient_ed"), s(d, "msg_id"), None, ts, dm::DM_AAD_MESSAGE).unwrap();
+    assert_eq!(pt, s(d, "plaintext"));
+    // Wrong direction, id, time or domain fail.
+    assert!(dm::decrypt_v2(&ct, s(d, "iv_b64"), s(d, "sender_enc_pub_b64"), &recip_priv, s(d, "recipient_ed"), s(d, "sender_ed"), s(d, "msg_id"), None, ts, dm::DM_AAD_MESSAGE).is_err());
+    assert!(dm::decrypt_v2(&ct, s(d, "iv_b64"), s(d, "sender_enc_pub_b64"), &recip_priv, s(d, "sender_ed"), s(d, "recipient_ed"), "other", None, ts, dm::DM_AAD_MESSAGE).is_err());
+    assert!(dm::decrypt_v2(&ct, s(d, "iv_b64"), s(d, "sender_enc_pub_b64"), &recip_priv, s(d, "sender_ed"), s(d, "recipient_ed"), s(d, "msg_id"), None, ts + 1, dm::DM_AAD_MESSAGE).is_err());
+    assert!(dm::decrypt_v2(&ct, s(d, "iv_b64"), s(d, "sender_enc_pub_b64"), &recip_priv, s(d, "sender_ed"), s(d, "recipient_ed"), s(d, "msg_id"), None, ts, dm::DM_AAD_ACK).is_err());
+    assert_eq!(hex::encode(dm::directional_key_v2(&recip_priv.diffie_hellman(&x25519_dalek::PublicKey::from(keys::x25519_public_raw(s(d, "sender_enc_pub_b64")).unwrap())).to_bytes(), s(d, "sender_ed"), s(d, "recipient_ed"))), s(d, "key_hex"));
+}
+
+/// The Hub owner-API request signature (`noslop-hub-api-v1`). The same value is asserted on the
+/// Android side (`HubClientSignatureTest`), so phone and Hub can't drift apart.
+pub const HUB_API_VECTOR_SIG: &str = "5V9Qft1L7FN3zcw425qkbqaswUhWnUufLz8prXFjOOVOT9Tct6E9lXO+4QIEIRMQpiQCFvp3MmGBa4t2E5c/AA==";
+
+#[test]
+fn hub_api_request_signature_is_pinned() {
+    let v = vectors();
+    let id = &v["identity"];
+    let ident = keys::Identity::from_b64(s(id, "public_key_b64"), s(id, "private_key_b64"), s(id, "enc_public_key_b64"), s(id, "enc_private_key_b64")).unwrap();
+    let body_sha = envelope::sha256_hex(br#"{"cmd":"hub_status","args":{}}"#);
+    let signed = canon::hub_api_request("POST", "/api/invoke", 1763700000000, "nonce_aaaaaaaaaaaaaaaa", &body_sha);
+    assert_eq!(signed, format!("17:noslop-hub-api-v14:POST11:/api/invoke13:176370000000022:nonce_aaaaaaaaaaaaaaaa64:{}", body_sha));
+    let sig = ident.sign(&signed);
+    assert_eq!(sig, HUB_API_VECTOR_SIG);
+}
