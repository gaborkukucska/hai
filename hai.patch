+# START OF FILE hainet-noslop/Cargo.toml
+[package]
+name = "hainet-noslop"
+version.workspace = true
+edition.workspace = true
+license.workspace = true
+repository.workspace = true
+homepage.workspace = true
+authors.workspace = true
+description = "NoSlop mesh protocol for the HAI-Net Home HUB: Gson-exact canonical JSON, envelope signatures, keys, DM crypto, and the creator-hosting node"
+
+[dependencies]
+ed25519-dalek = { workspace = true }
+x25519-dalek = { workspace = true }
+chacha20poly1305 = { workspace = true }
+sha3 = { workspace = true }
+sha2 = "0.10"
+hkdf = "0.12"
+base64 = { workspace = true }
+base32 = "0.5.1"
+hex = "0.4"
+rand = { workspace = true }
+thiserror = { workspace = true }
+uuid = { workspace = true }
+serde_json = { workspace = true }
+
+# The Home HUB node (feature "hub"): mesh listeners, durable store, Tor, owner API.
+tokio = { workspace = true, optional = true }
+tokio-socks = { version = "0.5.1", optional = true }
+tracing = { workspace = true, optional = true }
+
+[dependencies.sqlx]
+workspace = true
+features = ["runtime-tokio-rustls", "sqlite"]
+optional = true
+
+[features]
+default = []
+hub = ["dep:tokio", "dep:tokio-socks", "dep:tracing", "dep:sqlx"]
+
+[dev-dependencies]
+tokio = { workspace = true }
