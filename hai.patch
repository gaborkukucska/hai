--- /dev/null
+++ b/hainet-noslop/src/hub/admin.rs
@@ -0,0 +1,71 @@
+//! START OF FILE hainet-noslop/src/hub/admin.rs
+//!
+//! Direct messages between the owner's phone and the Hub's Admin AI (`admin_<personal key>`, the
+//! contact `NoSlopRepository.ensureAdminPeerExists` creates with the owner's own X25519 key).
+//!
+//! NoSlop 0.7+ only sends DM v2, so the owner's message is opened as v2 (sender = owner key,
+//! recipient = `admin_<owner key>`), with the legacy v1 form as fallback. A `DM_ACK` v3 is returned at
+//! once, so the phone marks the message delivered instead of re-sending it while the AI thinks, and
+//! the reply is sealed as v2 the other way round.
+
+use crate::{dm, json::JValue, keys::Identity, packet::Packet};
+
+/// `DmPacketHandler.ACK_PLAINTEXT`.
+pub const ACK_PLAINTEXT: &str = "ACK";
+
+pub fn admin_id(owner: &Identity) -> String { format!("admin_{}", owner.public_key_b64) }
+
+/// Whether `pkt` is the owner's message to the Admin AI.
+pub fn is_owner_to_admin(owner: &Identity, pkt: &Packet) -> bool {
+    pkt.ptype == "MESSAGE" && pkt.sender_id == owner.public_key_b64 && pkt.target_user_id.as_deref() == Some(admin_id(owner).as_str())
+}
+
+/// Opens the owner's message. Returns (message id, text). A JSON body `{"content": ...}` gives its content.
+pub fn open_owner_message(owner: &Identity, pkt: &Packet) -> Result<(String, String), String> {
+    let p = pkt.payload.as_ref().ok_or("no payload")?;
+    let id = p.get_str("id").ok_or("no id")?;
+    let ct = p.get_str("ciphertext").ok_or("no ciphertext")?;
+    let nonce = p.get_str("nonce").ok_or("no nonce")?;
+    let ts = p.get_i64("timestamp").unwrap_or(0);
+    let secret = owner.x25519_secret();
+    let plain = dm::decrypt_v2(ct, nonce, &owner.enc_public_key_b64, &secret, &owner.public_key_b64, &admin_id(owner), id, None, ts, dm::DM_AAD_MESSAGE)
+        .or_else(|_| dm::decrypt_v1(ct, nonce, &owner.enc_public_key_b64, &secret))
+        .map_err(|e| format!("cannot open the message: {}", e))?;
+    let text = crate::json::parse(&plain).ok().and_then(|v| v.get_str("content").map(String::from)).unwrap_or(plain);
+    Ok((id.to_string(), text))
+}
+
+/// The Admin AI's reply: a v2 `MESSAGE` from `admin_<owner>` to the owner, as the phone reads it
+/// from the inbox (`DmPacketHandler.handleDirectMessage`).
+pub fn reply_packet(owner: &Identity, text: &str, now: i64) -> Result<Packet, String> {
+    let me = admin_id(owner);
+    let secret = owner.x25519_secret();
+    let body = JValue::obj().with("content", JValue::str(text)).render();
+    let msg_id = uuid::Uuid::new_v4().to_string();
+    let (ct, iv) = dm::encrypt_v2(&body, &owner.enc_public_key_b64, &secret, &me, &owner.public_key_b64, &msg_id, None, now, dm::DM_AAD_MESSAGE).map_err(|e| e.to_string())?;
+    let payload = JValue::obj()
+        .with("id", JValue::str(&msg_id))
+        .with("nonce", JValue::str(iv))
+        .with("ciphertext", JValue::str(ct))
+        .with("timestamp", JValue::int(now))
+        .with("v", JValue::int(2));
+    Ok(Packet::new("MESSAGE", &me, Some(&owner.public_key_b64), payload, 1))
+}
+
+/// The `DM_ACK` (v3, with the legacy form alongside, as `DmPacketHandler.sendDmAck` writes it) for
+/// the owner's message `msg_id`, so the phone stops re-sending it (`handleDmAck`).
+pub fn ack_packet(owner: &Identity, msg_id: &str, now: i64) -> Result<Packet, String> {
+    let me = admin_id(owner);
+    let secret = owner.x25519_secret();
+    let (ack_ct, ack_iv) = dm::encrypt_v2(ACK_PLAINTEXT, &owner.enc_public_key_b64, &secret, &me, &owner.public_key_b64, msg_id, None, now, dm::DM_AAD_ACK).map_err(|e| e.to_string())?;
+    let (legacy_ct, legacy_iv) = dm::encrypt_v2(ACK_PLAINTEXT, &owner.enc_public_key_b64, &secret, &me, &owner.public_key_b64, msg_id, None, now, dm::DM_AAD_MESSAGE).map_err(|e| e.to_string())?;
+    let payload = JValue::obj()
+        .with("msg_id", JValue::str(msg_id))
+        .with("nonce", JValue::str(legacy_iv))
+        .with("ciphertext", JValue::str(legacy_ct))
+        .with("timestamp", JValue::int(now))
+        .with("v", JValue::int(3))
+        .with("ack_nonce", JValue::str(ack_iv))
+        .with("ack_ciphertext", JValue::str(ack_ct));
+    Ok(Packet::new("DM_ACK", &me, Some(&owner.public_key_b64), payload, 1))
+}
diff --git a/hainet-noslop/src/hub/api.rs b/hainet-noslop/src/hub/api.rs
new file mode 100644
index 0000000..66784d3
--- /dev/null
+++ b/hainet-noslop/src/hub/api.rs
@@ -0,0 +1,498 @@
+//! START OF FILE hainet-noslop/src/hub/api.rs
+//!
+//! The owner's control API of the NoSlop Home HUB (served by `hainet-core` on `/api/invoke`).
+//!
+//! **Authentication.** Every request from the phone carries an owner signature in four headers:
+//! `X-NoSlop-Hub-Key` (the owner's personal public key, which must be the Hub's own identity),
+//! `X-NoSlop-Hub-Ts` (ms, within ±5 minutes), `X-NoSlop-Hub-Nonce` (16-64 chars of `[A-Za-z0-9_-]`,
+//! never reused within 10 minutes) and `X-NoSlop-Hub-Sig`, an Ed25519 signature over
+//! `encodeForSigning("noslop-hub-api-v1", METHOD, PATH, ts, nonce, sha256hex(raw body))`.
+//! Being able to reach the API (LAN or onion) is not authentication.
+//!
+//! Commands (`{"cmd": ..., "args": {...}}`), all returning JSON:
+//!
+//! | cmd | what it does |
+//! |---|---|
+//! | `hub_status` | identities, creator hosting and onion state, inbox and content counts |
+//! | `hub_send` | `{items:[{onion, packet}]}`: send each packet to the onion the phone chose |
+//! | `hub_inbox_pull` | `{after, limit, max_bytes}`: stored packets and notices, oldest first |
+//! | `hub_inbox_ack` | `{up_to}`: removes everything up to that sequence number |
+//! | `hub_contacts_push` | `{contacts:[...], full}`: the phone's contacts (which identity each knows) |
+//! | `creator_identity_set` / `creator_identity_remove` | the creator identity's keys |
+//! | `creator_profile_set` | the creator profile and the creator / discoverable switches |
+//! | `creator_hosting_set` | `{enabled}`: the Hub takes over (or gives back) the creator onion |
+//! | `creator_content_sync` | `{posts, comments, reactions, keep_ids, full}`: the creator's public content |
+//! | `creator_media_put` / `creator_media_status` | resumable upload of the creator's public media |
+//! | `sync_push_packets` / `sync_pull_packets` | older clients: same paths, without destinations / ACKs |
+
+use super::{admin, content, creator, store::Contact, tor, CreatorProfile, HubNode, Retry};
+use crate::{canon, envelope::sha256_hex, json::JValue, keys, packet::Packet};
+use serde_json::{json, Value};
+use std::collections::HashMap;
+use std::sync::Arc;
+use tokio::io::AsyncWriteExt;
+use tokio::sync::Mutex;
+use tracing::{info, warn};
+
+pub const API_PROTOCOL: i64 = 1;
+const MAX_SKEW_MS: i64 = 5 * 60_000;
+const NONCE_TTL_MS: i64 = 10 * 60_000;
+/// Largest media upload chunk (raw bytes) per `creator_media_put`.
+pub const MEDIA_PUT_MAX: usize = 1024 * 1024;
+
+/// Remembers request nonces for [`NONCE_TTL_MS`].
+#[derive(Default)]
+pub struct NonceCache { seen: Mutex<HashMap<String, i64>> }
+
+impl NonceCache {
+    async fn admit(&self, nonce: &str, now: i64) -> bool {
+        let mut m = self.seen.lock().await;
+        m.retain(|_, t| now - *t < NONCE_TTL_MS);
+        if m.contains_key(nonce) { return false; }
+        m.insert(nonce.to_string(), now);
+        true
+    }
+}
+
+/// Owner-signature headers, looked up case-insensitively by the caller (keys lower-cased).
+pub async fn verify_owner_request(node: &HubNode, nonces: &NonceCache, method: &str, path: &str, headers: &HashMap<String, String>, body: &[u8]) -> Result<(), String> {
+    let body_hash = sha256_hex(body);
+    verify_owner_request_hashed(node, nonces, method, path, headers, &body_hash).await
+}
+
+/// As [`verify_owner_request`] when the body was hashed while streaming it to disk.
+pub async fn verify_owner_request_hashed(node: &HubNode, nonces: &NonceCache, method: &str, path: &str, headers: &HashMap<String, String>, body_sha256_hex: &str) -> Result<(), String> {
+    let h = |k: &str| headers.get(k).map(|s| s.trim().to_string()).filter(|s| !s.is_empty());
+    let (Some(key), Some(ts), Some(nonce), Some(sig)) = (h("x-noslop-hub-key"), h("x-noslop-hub-ts"), h("x-noslop-hub-nonce"), h("x-noslop-hub-sig")) else {
+        return Err("missing owner signature".into());
+    };
+    let owner = node.personal().await.ok_or("this Hub has no owner identity")?;
+    if key != owner.public_key_b64 { return Err("not the owner of this Hub".into()); }
+    let ts: i64 = ts.parse().map_err(|_| "bad timestamp")?;
+    let now = node.now();
+    if (now - ts).abs() > MAX_SKEW_MS { return Err("request timestamp too far from the Hub's clock".into()); }
+    if nonce.len() < 16 || nonce.len() > 64 || !nonce.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-') { return Err("bad nonce".into()); }
+    if !keys::verify(&canon::hub_api_request(method, path, ts, &nonce, body_sha256_hex), &sig, &owner.public_key_b64) {
+        return Err("owner signature does not verify".into());
+    }
+    if !nonces.admit(&nonce, now).await { return Err("replayed request".into()); }
+    Ok(())
+}
+
+fn arr<'a>(args: &'a JValue, k: &str) -> &'a [JValue] { args.get(k).and_then(|v| v.as_array()).map(|v| v.as_slice()).unwrap_or(&[]) }
+fn s<'a>(v: &'a JValue, k: &str) -> &'a str { v.get_str(k).unwrap_or("") }
+
+/// Handles a Hub command, or returns `None` when `cmd` is not one of them. `args` keeps the wire
+/// order of the request (packets inside are passed on exactly as the phone wrote them).
+pub async fn handle(node: &Arc<HubNode>, cmd: &str, args: &JValue) -> Option<Result<Value, String>> {
+    Some(match cmd {
+        "hub_status" => status(node).await,
+        "hub_send" => send(node, args).await,
+        "hub_inbox_pull" => inbox_pull(node, args).await,
+        "hub_inbox_ack" => {
+            let up_to = args.get_i64("up_to").unwrap_or(0);
+            node.store.inbox_ack(up_to).await.map(|n| json!({"status": "ok", "deleted": n})).map_err(|e| e.to_string())
+        }
+        "hub_contacts_push" => contacts_push(node, args).await,
+        "creator_identity_set" => creator_identity_set(node, args).await,
+        "creator_identity_remove" => creator_identity_remove(node).await,
+        "creator_profile_set" => {
+            let opt = |k: &str| args.get_str(k).filter(|v| !v.trim().is_empty()).map(String::from);
+            let p = CreatorProfile {
+                display_name: s(args, "display_name").into(), handle: s(args, "handle").into(), bio: opt("bio"), avatar_b64: opt("avatar_b64"),
+                fund_me_link: opt("fund_me_link"), is_creator: args.get_bool("is_creator").unwrap_or(false), is_discoverable: args.get_bool("is_discoverable").unwrap_or(false),
+            };
+            node.set_profile(p).await.map(|_| json!({"status": "ok"}))
+        }
+        "creator_hosting_set" => {
+            let on = args.get_bool("enabled").unwrap_or(false);
+            if on && node.creator().await.is_none() { Err("no creator identity on this Hub".into()) } else {
+                match node.set_hosting(on).await {
+                    Ok(()) => { info!("NOSLOP_HUB: creator hosting {}", if on { "ON" } else { "OFF" }); status(node).await }
+                    Err(e) => Err(e),
+                }
+            }
+        }
+        "creator_content_sync" => content_sync(node, args).await,
+        "creator_media_put" => media_put(node, args).await,
+        "creator_media_status" => {
+            let mut out = vec![];
+            for id in arr(args, "media_ids") {
+                let id = id.as_str().unwrap_or("");
+                let row = node.store.media_get(id).await.ok().flatten();
+                out.push(json!({"media_id": id, "received": row.as_ref().map(|r| r.received).unwrap_or(0), "complete": row.map(|r| r.complete).unwrap_or(false)}));
+            }
+            Ok(json!({"status": "ok", "media": out}))
+        }
+        "sync_push_packets" => legacy_push(node, args).await,
+        "sync_pull_packets" => legacy_pull(node).await,
+        _ => return None,
+    })
+}
+
+async fn status(node: &Arc<HubNode>) -> Result<Value, String> {
+    let personal = node.personal().await;
+    let creator = node.creator().await;
+    let onion = node.onion_status().await;
+    let (inbox_n, inbox_b) = node.store.inbox_stats().await.map_err(|e| e.to_string())?;
+    let contacts = node.store.contacts_all().await.map_err(|e| e.to_string())?;
+    let posts = node.store.post_ids().await.map_err(|e| e.to_string())?.len();
+    let media_bytes = node.store.media_total_bytes().await.map_err(|e| e.to_string())?;
+    let profile = node.profile().await;
+    let hosting = node.hosting().await;
+    Ok(json!({
+        "status": "ok",
+        "api_protocol": API_PROTOCOL,
+        "hub_version": env!("CARGO_PKG_VERSION"),
+        "personal": personal.map(|p| json!({"public_key": p.public_key_b64, "onion_address": p.onion})),
+        "creator": creator.map(|c| json!({
+            "public_key": c.public_key_b64,
+            "onion_address": c.onion,
+            "hosting": hosting,
+            "onion_published": onion.published,
+            "onion_error": onion.error,
+            "is_creator": profile.is_creator,
+            "is_discoverable": profile.is_discoverable,
+        })),
+        "creator_hosting": hosting,
+        "inbox": {"items": inbox_n, "bytes": inbox_b},
+        "contacts": {"total": contacts.len(), "creator_followers": contacts.iter().filter(|c| c.identity == "creator" && c.relationship == "ACCEPTED").count(), "awaiting_phone": contacts.iter().filter(|c| c.source == "hub").count()},
+        "creator_content": {"posts": posts, "media_bytes": media_bytes, "media_quota": node.cfg.media_quota},
+        "server_time": node.now(),
+    }))
+}
+
+/// The retry policy for a packet the phone hands over.
+fn retry_for(ptype: &str) -> Retry {
+    match ptype {
+        "SYNC_RESPONSE" => Retry::Sync,
+        "TYPING" | "READ_RECEIPT" | "ANNOUNCE_PEER" | "ANNOUNCE_DISCOVERABLE" | "USER_EXIT" => Retry::Once,
+        t if t.starts_with("MEDIA_") => Retry::Once,
+        _ => Retry::Spool,
+    }
+}
+
+/// What the Hub learns from a packet the phone is sending (creator content, Admin AI messages).
+/// Returns true when the packet was for the Hub itself and must not go out.
+async fn observe_outgoing(node: &Arc<HubNode>, pkt: &Packet) -> bool {
+    if let Some(owner) = node.personal().await {
+        if admin::is_owner_to_admin(&owner, pkt) {
+            match node.admin_hook.read().await.clone() {
+                Some(hook) => { tokio::spawn(hook(pkt.clone())); }
+                None => warn!("NOSLOP_HUB: message for the Admin AI, but no Admin AI is running on this Hub"),
+            }
+            return true;
+        }
+    }
+    if let Some(c) = node.creator().await {
+        if pkt.sender_id == c.public_key_b64 || pkt.p_str("author_id") == Some(c.public_key_b64.as_str()) {
+            match pkt.ptype.as_str() {
+                "POST" | "EDIT_POST" | "DELETE_POST" => creator::apply_creator_post_packet(node, pkt).await,
+                _ => {}
+            }
+        }
+    }
+    if matches!(pkt.ptype.as_str(), "COMMENT" | "EDIT_COMMENT" | "DELETE_COMMENT" | "REACTION") {
+        creator::apply_engagement(node, pkt).await;
+    }
+    false
+}
+
+async fn send(node: &Arc<HubNode>, args: &JValue) -> Result<Value, String> {
+    let items = arr(args, "items");
+    if items.len() > 500 { return Err("too many items (max 500)".into()); }
+    let (mut queued, mut local, mut rejected) = (0, 0, vec![]);
+    for (i, it) in items.iter().enumerate() {
+        let Some(pv) = it.get("packet") else { rejected.push(json!({"index": i, "reason": "no packet"})); continue };
+        let pkt = match Packet::from_value(pv) { Ok(p) => p, Err(e) => { rejected.push(json!({"index": i, "reason": e.to_string()})); continue } };
+        if observe_outgoing(node, &pkt).await { local += 1; continue; }
+        let onion = s(it, "onion");
+        if !tor::is_valid_onion(onion) { rejected.push(json!({"index": i, "reason": "invalid onion"})); continue; }
+        node.deliver(onion.to_string(), pkt.clone(), retry_for(&pkt.ptype));
+        queued += 1;
+    }
+    Ok(json!({"status": "ok", "queued": queued, "handled_by_hub": local, "rejected": rejected}))
+}
+
+async fn inbox_pull(node: &Arc<HubNode>, args: &JValue) -> Result<Value, String> {
+    let after = args.get_i64("after").unwrap_or(0);
+    let limit = args.get_i64("limit").unwrap_or(200).clamp(1, 500);
+    let max_bytes = args.get_i64("max_bytes").unwrap_or(4 * 1024 * 1024).clamp(64 * 1024, 16 * 1024 * 1024);
+    let (items, more) = node.store.inbox_pull(after, limit, max_bytes).await.map_err(|e| e.to_string())?;
+    let out: Vec<Value> = items.into_iter().map(|i| json!({"seq": i.seq, "kind": i.kind, "packet": i.packet})).collect();
+    Ok(json!({"status": "ok", "items": out, "more": more}))
+}
+
+fn contact_from(v: &JValue, default_identity: &str) -> Option<Contact> {
+    let key = v.get_str("public_key")?.trim();
+    if key.is_empty() { return None; }
+    let trusted = v.get_bool("is_trusted").unwrap_or(false);
+    let identity = match v.get_str("identity") { Some("creator") => "creator", Some("personal") => "personal", _ => default_identity };
+    let onion = v.get_str("onion_address").unwrap_or("").trim().to_ascii_lowercase();
+    Some(Contact {
+        public_key: key.to_string(),
+        identity: identity.to_string(),
+        relationship: v.get_str("relationship").map(String::from).unwrap_or_else(|| if trusted { "ACCEPTED".into() } else { "NONE".into() }),
+        is_trusted: trusted,
+        is_temporary: v.get_bool("is_temporary").unwrap_or(false),
+        handle: v.get_str("handle").unwrap_or("").to_string(),
+        onion_address: if tor::is_valid_onion(&onion) { onion } else { String::new() },
+        enc_public_key: v.get_str("enc_public_key").unwrap_or("").to_string(),
+        source: "phone".into(),
+        declined_nonce: v.get_str("declined_nonce").unwrap_or("").to_string(),
+    })
+}
+
+/// Contacts as the phone pushes them. A full push replaces the phone's rows (rows the Hub added for
+/// followers stay until the phone lists them).
+pub async fn contacts_push(node: &Arc<HubNode>, args: &JValue) -> Result<Value, String> {
+    let (owner, creator) = (node.personal().await.map(|i| i.public_key_b64), node.creator().await.map(|i| i.public_key_b64));
+    let list: Vec<Contact> = arr(args, "contacts").iter().chain(arr(args, "peers").iter())
+        .filter_map(|v| contact_from(v, "personal"))
+        .filter(|c| Some(&c.public_key) != owner.as_ref() && Some(&c.public_key) != creator.as_ref() && !c.public_key.starts_with("admin_"))
+        .collect();
+    let now = node.now();
+    if args.get_bool("full").unwrap_or(true) {
+        let removed = node.store.contacts_replace_from_phone(&list, now).await.map_err(|e| e.to_string())?;
+        // The phone now owns every follower it lists; the Hub's own rows for them are replaced above.
+        for c in &list {
+            if let Ok(Some(row)) = node.store.contact_get(&c.public_key).await { if row.source == "hub" { let _ = node.store.contact_upsert(c, now).await; } }
+        }
+        Ok(json!({"status": "ok", "contacts": list.len(), "removed": removed.len()}))
+    } else {
+        for c in &list { node.store.contact_upsert(c, now).await.map_err(|e| e.to_string())?; }
+        Ok(json!({"status": "ok", "contacts": list.len()}))
+    }
+}
+
+fn write_secret(path: &std::path::Path, value: &str) -> std::io::Result<()> {
+    use std::io::Write;
+    let mut opts = std::fs::OpenOptions::new();
+    opts.write(true).create(true).truncate(true);
+    #[cfg(unix)] { use std::os::unix::fs::OpenOptionsExt; opts.mode(0o600); }
+    let mut f = opts.open(path)?;
+    f.write_all(value.as_bytes())?;
+    #[cfg(unix)] { use std::os::unix::fs::PermissionsExt; std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o600))?; }
+    Ok(())
+}
+
+async fn creator_identity_set(node: &Arc<HubNode>, args: &JValue) -> Result<Value, String> {
+    let (pk, sk, epk, esk) = (s(args, "public_key"), s(args, "private_key"), s(args, "enc_public_key"), s(args, "enc_private_key"));
+    let id = keys::Identity::from_b64(pk, sk, epk, esk).map_err(|e| format!("creator keys rejected: {}", e))?;
+    if let Some(owner) = node.personal().await { if owner.public_key_b64 == id.public_key_b64 { return Err("the creator identity must not be the personal identity".into()); } }
+    if let Some(cur) = node.creator().await {
+        if cur.public_key_b64 != id.public_key_b64 && !args.get_bool("replace").unwrap_or(false) {
+            return Err("this Hub holds a different creator identity; send replace=true to replace it".into());
+        }
+    }
+    let dir = node.cfg.creator_dir();
+    std::fs::create_dir_all(&dir).map_err(|e| e.to_string())?;
+    #[cfg(unix)] { use std::os::unix::fs::PermissionsExt; let _ = std::fs::set_permissions(&dir, std::fs::Permissions::from_mode(0o700)); }
+    for (f, v) in [("ed25519_pub.b64", pk), ("ed25519_priv.b64", sk), ("x25519_pub.b64", epk), ("x25519_priv.b64", esk), ("onion_address", id.onion.as_str()), ("display_name", s(args, "display_name"))] {
+        write_secret(&dir.join(f), v.trim()).map_err(|e| format!("could not write {}: {}", f, e))?;
+    }
+    let onion = id.onion.clone();
+    node.set_creator(Some(id)).await;
+    info!("NOSLOP_HUB: creator identity stored ({})", tor::short(&onion));
+    Ok(json!({"status": "ok", "onion_address": onion}))
+}
+
+async fn creator_identity_remove(node: &Arc<HubNode>) -> Result<Value, String> {
+    node.set_hosting(false).await?;
+    let dir = node.cfg.creator_dir();
+    if dir.exists() { std::fs::remove_dir_all(&dir).map_err(|e| e.to_string())?; }
+    node.set_creator(None).await;
+    for id in node.store.post_ids().await.map_err(|e| e.to_string())? { let _ = creator::remove_creator_post(node, &id).await; }
+    for c in node.store.contacts_for_identity("creator").await.map_err(|e| e.to_string())? {
+        let _ = sqlx::query("DELETE FROM nh_contacts WHERE public_key = ?").bind(&c.public_key).execute(&node.store.pool).await;
+    }
+    info!("NOSLOP_HUB: creator identity, its content and its followers removed from the Hub");
+    Ok(json!({"status": "ok"}))
+}
+
+async fn content_sync(node: &Arc<HubNode>, args: &JValue) -> Result<Value, String> {
+    let creator = node.creator().await.ok_or("no creator identity on this Hub")?;
+    let now = node.now();
+    let (mut stored, mut rejected, mut ids) = (0, vec![], std::collections::HashSet::new());
+    for p in arr(args, "posts") {
+        match creator::store_creator_post(node, p, &creator.public_key_b64, now).await {
+            Ok(info) => { ids.insert(info.id); stored += 1; }
+            Err(e) => rejected.push(json!({"id": p.get_str("id"), "reason": e})),
+        }
+    }
+    // `full`: the phone's complete list of creator posts is this call's posts plus `keep_ids` (a large
+    // history is sent in batches, the last one naming every id); anything else was deleted on the phone.
+    if args.get_bool("full").unwrap_or(false) {
+        for k in arr(args, "keep_ids") { if let Some(id) = k.as_str() { ids.insert(id.to_string()); } }
+        for id in node.store.post_ids().await.map_err(|e| e.to_string())? {
+            if !ids.contains(&id) { creator::remove_creator_post(node, &id).await?; }
+        }
+    }
+    let (mut comments, mut reactions) = (0, 0);
+    for c in arr(args, "comments") {
+        match content::verify_comment(c) {
+            Ok((id, post_id, author, ts)) if node.store.post_get(&post_id).await.ok().flatten().is_some() => {
+                node.store.comment_upsert(&id, &post_id, &author, ts, &c.without_null_members().render()).await.map_err(|e| e.to_string())?;
+                comments += 1;
+            }
+            Ok(_) => {}
+            Err(e) => rejected.push(json!({"id": c.get_str("id"), "reason": e})),
+        }
+    }
+    for r in arr(args, "reactions") {
+        match content::verify_reaction(r) {
+            Ok((id, post_id, author, ts)) if node.store.post_get(&post_id).await.ok().flatten().is_some() => {
+                node.store.reaction_upsert(&id, &post_id, &author, ts, &r.without_null_members().render()).await.map_err(|e| e.to_string())?;
+                reactions += 1;
+            }
+            Ok(_) => {}
+            Err(e) => rejected.push(json!({"id": r.get_str("id"), "reason": e})),
+        }
+    }
+    // Media the phone still has to upload: every stored post's media that is not complete here.
+    let mut needed = vec![];
+    for id in node.store.post_ids().await.map_err(|e| e.to_string())? {
+        let Some(post) = node.store.post_get(&id).await.ok().flatten() else { continue };
+        let Some(mid) = post.media_id else { continue };
+        let row = node.store.media_get(&mid).await.ok().flatten();
+        if row.as_ref().map(|r| r.complete).unwrap_or(false) { continue; }
+        let meta = crate::json::parse(&post.payload).ok().and_then(|v| v.get("media_metadata").cloned());
+        needed.push(json!({
+            "media_id": mid,
+            "sha256": meta.as_ref().and_then(|m| m.get_str("sha256").map(String::from)),
+            "received": row.map(|r| r.received).unwrap_or(0),
+        }));
+    }
+    Ok(json!({"status": "ok", "posts": stored, "comments": comments, "reactions": reactions, "rejected": rejected, "media_needed": needed}))
+}
+
+/// One chunk of a creator media upload. Chunks must arrive in order (`offset` = bytes already
+/// received, which the reply and `creator_media_status` report); the file is checked against its
+/// SHA-256 when complete and only then served.
+async fn media_put(node: &Arc<HubNode>, args: &JValue) -> Result<Value, String> {
+    let media_id = s(args, "media_id");
+    if !creator::is_valid_media_id(media_id) { return Err("invalid media id".into()); }
+    let sha = s(args, "sha256").to_ascii_lowercase();
+    if sha.len() != 64 || !sha.bytes().all(|b| b.is_ascii_hexdigit()) { return Err("sha256 must be 64 hex characters".into()); }
+    let size = args.get_i64("size").ok_or("missing size")?;
+    if size <= 0 { return Err("bad size".into()); }
+    let offset = args.get_i64("offset").ok_or("missing offset")?;
+    let data = keys::b64_decode(s(args, "data")).map_err(|_| "data is not Base64")?;
+    if data.len() > MEDIA_PUT_MAX { return Err(format!("chunk larger than {} bytes", MEDIA_PUT_MAX)); }
+    if node.store.post_ids().await.map_err(|e| e.to_string())?.is_empty() { return Err("no creator posts on this Hub yet".into()); }
+    if !node.store.media_in_use(media_id).await.map_err(|e| e.to_string())? { return Err("no stored creator post uses this media".into()); }
+    let now = node.now();
+    let dir = node.cfg.media_dir();
+    tokio::fs::create_dir_all(&dir).await.map_err(|e| e.to_string())?;
+    let mut row = node.store.media_get(media_id).await.map_err(|e| e.to_string())?.unwrap_or(super::store::MediaRow {
+        media_id: media_id.into(), mtype: String::new(), mime_type: String::new(), size, sha256: sha.clone(), received: 0, complete: false,
+    });
+    if row.complete && row.sha256 == sha { return Ok(json!({"status": "ok", "received": row.received, "complete": true})); }
+    if row.sha256 != sha || row.size != size { row.received = 0; row.complete = false; row.sha256 = sha.clone(); row.size = size; }
+    row.mtype = s(args, "type").to_string();
+    row.mime_type = args.get_str("mime_type").unwrap_or("application/octet-stream").to_string();
+    if offset != row.received { return Ok(json!({"status": "resume", "received": row.received, "complete": false})); }
+    if offset + data.len() as i64 > size { return Err("chunk runs past the declared size".into()); }
+    let used = node.store.media_total_bytes().await.map_err(|e| e.to_string())? - row.received;
+    if used + size > node.cfg.media_quota { return Err("the Hub's creator media quota is full".into()); }
+    let part = dir.join(format!("{}.part", media_id));
+    let mut f = tokio::fs::OpenOptions::new().create(true).write(true).truncate(offset == 0).open(&part).await.map_err(|e| e.to_string())?;
+    if offset > 0 {
+        use tokio::io::AsyncSeekExt;
+        let len = f.metadata().await.map_err(|e| e.to_string())?.len() as i64;
+        if len < offset { row.received = 0; node.store.media_put(&row, now).await.map_err(|e| e.to_string())?; return Ok(json!({"status": "resume", "received": 0, "complete": false})); }
+        f.set_len(offset as u64).await.map_err(|e| e.to_string())?;
+        f.seek(std::io::SeekFrom::Start(offset as u64)).await.map_err(|e| e.to_string())?;
+    }
+    f.write_all(&data).await.map_err(|e| e.to_string())?;
+    f.flush().await.map_err(|e| e.to_string())?;
+    drop(f);
+    row.received = offset + data.len() as i64;
+    if row.received == size {
+        let bytes = tokio::fs::read(&part).await.map_err(|e| e.to_string())?;
+        if sha256_hex(&bytes) != sha {
+            let _ = tokio::fs::remove_file(&part).await;
+            row.received = 0;
+            node.store.media_put(&row, now).await.map_err(|e| e.to_string())?;
+            return Err("the uploaded file does not match its SHA-256; upload it again".into());
+        }
+        tokio::fs::rename(&part, dir.join(media_id)).await.map_err(|e| e.to_string())?;
+        row.complete = true;
+        info!("NOSLOP_HUB: creator media {} stored ({} bytes)", media_id, size);
+    }
+    node.store.media_put(&row, now).await.map_err(|e| e.to_string())?;
+    Ok(json!({"status": "ok", "received": row.received, "complete": row.complete}))
+}
+
+/// Older clients: `{packets:[...]}` without destinations. A directed packet goes to the target's
+/// stored onion (or the onion its key gives); anything else to every trusted personal contact.
+async fn legacy_push(node: &Arc<HubNode>, args: &JValue) -> Result<Value, String> {
+    let mut queued = 0;
+    for pv in arr(args, "packets") {
+        let Ok(pkt) = Packet::from_value(pv) else { continue };
+        if observe_outgoing(node, &pkt).await { continue; }
+        let retry = retry_for(&pkt.ptype);
+        if let Some(t) = pkt.target_user_id.clone() {
+            let onion = node.store.contact_get(&t).await.ok().flatten().map(|c| c.onion_address).filter(|o| tor::is_valid_onion(o)).or_else(|| keys::onion_of(&t));
+            if let Some(o) = onion { node.deliver(o, pkt, retry); queued += 1; }
+        } else {
+            for c in node.store.contacts_for_identity("personal").await.map_err(|e| e.to_string())? {
+                if c.is_trusted && tor::is_valid_onion(&c.onion_address) { node.deliver(c.onion_address, pkt.clone(), retry); queued += 1; }
+            }
+        }
+    }
+    Ok(json!({"status": "ok", "packets_processed": queued}))
+}
+
+/// Older clients: everything in the inbox, removed as it is handed out (no ACK).
+async fn legacy_pull(node: &Arc<HubNode>) -> Result<Value, String> {
+    let (items, _) = node.store.inbox_pull(0, 500, 8 * 1024 * 1024).await.map_err(|e| e.to_string())?;
+    let mut packets = vec![];
+    let mut last = 0;
+    for i in &items {
+        last = i.seq;
+        if i.kind == "packet" { if let Ok(v) = serde_json::from_str::<Value>(&i.packet) { packets.push(v); } }
+    }
+    if last > 0 { node.store.inbox_ack(last).await.map_err(|e| e.to_string())?; }
+    Ok(json!({"status": "ok", "packets": packets}))
+}
+
+// --- Backups ----------------------------------------------------------------------------------
+
+/// Keeps an uploaded backup (already written to `tmp` and checked by the caller) and prunes old ones.
+pub async fn backup_store(node: &HubNode, tmp: &std::path::Path, sha256: &str, size: u64) -> Result<Value, String> {
+    let dir = node.cfg.backup_dir();
+    tokio::fs::create_dir_all(&dir).await.map_err(|e| e.to_string())?;
+    let name = format!("noslop_backup_{}.bin", node.now());
+    tokio::fs::rename(tmp, dir.join(&name)).await.map_err(|e| e.to_string())?;
+    #[cfg(unix)] { use std::os::unix::fs::PermissionsExt; let _ = std::fs::set_permissions(dir.join(&name), std::fs::Permissions::from_mode(0o600)); }
+    // Sidecar read by GET /api/backup/pull for the X-Backup-Sha256 header.
+    let sidecar = dir.join(&name).with_extension("sha256");
+    tokio::fs::write(&sidecar, sha256.as_bytes()).await.map_err(|e| e.to_string())?;
+    #[cfg(unix)] { use std::os::unix::fs::PermissionsExt; let _ = std::fs::set_permissions(&sidecar, std::fs::Permissions::from_mode(0o600)); }
+    let mut all = backup_list(node).await;
+    while all.len() > node.cfg.backup_keep.max(1) {
+        let old = dir.join(all.remove(0));
+        let _ = tokio::fs::remove_file(old.with_extension("sha256")).await;
+        let _ = tokio::fs::remove_file(old).await;
+    }
+    info!("NOSLOP_HUB: backup stored ({} bytes)", size);
+    Ok(json!({"status": "ok", "name": name, "size": size, "sha256": sha256}))
+}
+
+/// Backup file names, oldest first.
+pub async fn backup_list(node: &HubNode) -> Vec<String> {
+    let mut names = vec![];
+    if let Ok(mut rd) = tokio::fs::read_dir(node.cfg.backup_dir()).await {
+        while let Ok(Some(e)) = rd.next_entry().await {
+            let n = e.file_name().to_string_lossy().to_string();
+            if n.starts_with("noslop_backup_") && n.ends_with(".bin") { names.push(n); }
+        }
+    }
+    names.sort();
+    names
+}
+
+pub async fn backup_latest(node: &HubNode) -> Option<std::path::PathBuf> {
+    backup_list(node).await.pop().map(|n| node.cfg.backup_dir().join(n))
+}
diff --git a/hainet-noslop/src/hub/content.rs b/hainet-noslop/src/hub/content.rs
new file mode 100644
index 0000000..112eb8b
--- /dev/null
+++ b/hainet-noslop/src/hub/content.rs
@@ -0,0 +1,147 @@
+//! START OF FILE hainet-noslop/src/hub/content.rs
+//!
+//! Signature checks for the content the Hub stores and serves on behalf of the creator, mirroring
+//! `MeshPacketVerifier` / `SyncPacketHandler.handleSyncResponse` (WIRE_PROTOCOL_REFERENCE §7):
+//!
+//! * Post (`PostPayload`): v2 `encodeForSigning(id, authorId, content, timestamp, avatar, privacy,
+//!   mediaId, clearnetUrl, sha256)` when `media_metadata.sha256` is set, else the 8-field form.
+//! * Comment (`CommentSyncData` / `CommentData`): v2 with the media digest, the 5-field form (with
+//!   avatar), the 4-field form, or the pipe form.
+//! * Reaction (`ReactionSyncData` / `ReactionPayload`): `encodeForSigning(postId, type, authorId,
+//!   timestamp)` or the pipe form.
+//!
+//! The Hub only ever stores what verifies, so a follower never receives something its own app would
+//! reject, and nothing on the Hub can be altered without breaking the creator's signature.
+
+use crate::{canon::encode_for_signing, json::JValue, keys};
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct PostInfo {
+    pub id: String,
+    pub author_id: String,
+    pub content: String,
+    pub timestamp: i64,
+    pub privacy: String,
+    pub media_id: Option<String>,
+    pub media_sha256: Option<String>,
+    /// Whether the v2 form (covering the media digest) verified.
+    pub signed_digest: bool,
+}
+
+fn need<'a>(v: &'a JValue, k: &'static str) -> Result<&'a str, String> {
+    v.get_str(k).ok_or_else(|| format!("missing {}", k))
+}
+
+/// Verifies a `PostPayload` (as carried in `POST`, `SYNC_RESPONSE.posts` or pushed by the owner).
+pub fn verify_post(p: &JValue) -> Result<PostInfo, String> {
+    let id = need(p, "id")?;
+    let author = need(p, "author_id")?;
+    let content = need(p, "content")?;
+    let ts = p.get_i64("timestamp").ok_or("missing timestamp")?;
+    let sig = need(p, "signature")?;
+    let avatar = p.get_str("author_avatar_b64");
+    let privacy = p.get_str("privacy").unwrap_or("public");
+    let media_id = p.get_str("media_id");
+    let clearnet = p.get_str("clearnet_url");
+    let meta = p.get("media_metadata").filter(|m| !m.is_null());
+    // S14: media id and metadata must agree.
+    match (media_id, meta) {
+        (Some(mid), Some(m)) => { if m.get_str("id") != Some(mid) { return Err("media_id does not match media_metadata.id".into()); } }
+        (Some(_), None) => return Err("media_id without media_metadata".into()),
+        (None, Some(_)) => return Err("media_metadata without media_id".into()),
+        (None, None) => {}
+    }
+    let sha = meta.and_then(|m| m.get_str("sha256"));
+    let ts_s = ts.to_string();
+    let base = [Some(id), Some(author), Some(content), Some(ts_s.as_str()), avatar, Some(privacy), media_id, clearnet];
+    let mut signed_digest = false;
+    let ok = if let Some(h) = sha {
+        let mut v2 = base.to_vec();
+        v2.push(Some(h));
+        if keys::verify(&encode_for_signing(&v2), sig, author) { signed_digest = true; true } else { keys::verify(&encode_for_signing(&base), sig, author) }
+    } else {
+        keys::verify(&encode_for_signing(&base), sig, author)
+    };
+    if !ok { return Err("post signature does not verify".into()); }
+    Ok(PostInfo {
+        id: id.into(), author_id: author.into(), content: content.into(), timestamp: ts, privacy: privacy.into(),
+        media_id: media_id.map(Into::into), media_sha256: sha.map(Into::into), signed_digest,
+    })
+}
+
+/// SHA3-256 hex of `id|author|content|timestamp`: the per-post hash of `INVENTORY_SYNC_REQUEST`.
+pub fn inventory_hash(id: &str, author: &str, content: &str, timestamp: i64) -> String {
+    use sha3::{Digest, Sha3_256};
+    hex::encode(Sha3_256::digest(format!("{}|{}|{}|{}", id, author, content, timestamp).as_bytes()))
+}
+
+/// Verifies a comment in `CommentSyncData` form (`post_id` inside). Returns (id, post_id, author, timestamp).
+pub fn verify_comment(c: &JValue) -> Result<(String, String, String, i64), String> {
+    let id = need(c, "id")?;
+    let post_id = need(c, "post_id")?;
+    let author = need(c, "author_id")?;
+    let content = need(c, "content")?;
+    let ts = c.get_i64("timestamp").ok_or("missing timestamp")?;
+    let sig = need(c, "signature")?;
+    let avatar = c.get_str("author_avatar_b64");
+    if !comment_signature_ok(post_id, id, content, ts, avatar, c.get("media_metadata").and_then(|m| m.get_str("sha256")), sig, author) {
+        return Err("comment signature does not verify".into());
+    }
+    Ok((id.into(), post_id.into(), author.into(), ts))
+}
+
+#[allow(clippy::too_many_arguments)]
+pub fn comment_signature_ok(post_id: &str, id: &str, content: &str, ts: i64, avatar: Option<&str>, sha: Option<&str>, sig: &str, author: &str) -> bool {
+    let ts_s = ts.to_string();
+    if let Some(h) = sha {
+        if keys::verify(&encode_for_signing(&[Some(post_id), Some(id), Some(content), Some(&ts_s), avatar, Some(h)]), sig, author) { return true; }
+    }
+    if keys::verify(&encode_for_signing(&[Some(post_id), Some(id), Some(content), Some(&ts_s), avatar]), sig, author) { return true; }
+    if keys::verify(&encode_for_signing(&[Some(post_id), Some(id), Some(content), Some(&ts_s)]), sig, author) { return true; }
+    let mut pipe = format!("{}|{}|{}|{}", post_id, id, content, ts);
+    if let Some(a) = avatar { pipe.push('|'); pipe.push_str(a); }
+    keys::verify(&pipe, sig, author)
+}
+
+pub fn reaction_signature_ok(post_id: &str, reaction_type: &str, author: &str, ts: i64, sig: &str) -> bool {
+    let ts_s = ts.to_string();
+    keys::verify(&encode_for_signing(&[Some(post_id), Some(reaction_type), Some(author), Some(&ts_s)]), sig, author)
+        || keys::verify(&format!("{}|{}|{}|{}", post_id, reaction_type, author, ts), sig, author)
+}
+
+/// Verifies a `ReactionSyncData`. Returns (id, post_id, author, timestamp).
+pub fn verify_reaction(r: &JValue) -> Result<(String, String, String, i64), String> {
+    let id = need(r, "id")?;
+    let post_id = need(r, "post_id")?;
+    let author = need(r, "author_id")?;
+    let rtype = need(r, "reaction_type")?;
+    let ts = r.get_i64("timestamp").ok_or("missing timestamp")?;
+    let sig = need(r, "signature")?;
+    if !reaction_signature_ok(post_id, rtype, author, ts, sig) { return Err("reaction signature does not verify".into()); }
+    Ok((id.into(), post_id.into(), author.into(), ts))
+}
+
+/// A live `COMMENT` payload (`CommentPayload { post_id, comment: CommentData, parent_comment_id }`)
+/// in the `CommentSyncData` form used by `SYNC_RESPONSE`.
+pub fn comment_payload_to_sync(payload: &JValue) -> Option<JValue> {
+    let post_id = payload.get_str("post_id")?;
+    let c = payload.get("comment")?;
+    Some(
+        JValue::obj()
+            .with("id", c.get("id")?.clone())
+            .with("post_id", JValue::str(post_id))
+            .with("author_id", c.get("author_id")?.clone())
+            .with("author_name", c.get("author_name").cloned().unwrap_or(JValue::str("")))
+            .with_opt("author_avatar_b64", c.get("author_avatar_b64").filter(|v| !v.is_null()).cloned())
+            .with("content", c.get("content")?.clone())
+            .with("timestamp", c.get("timestamp")?.clone())
+            .with("signature", c.get("signature")?.clone())
+            .with_opt("parent_comment_id", payload.get("parent_comment_id").filter(|v| !v.is_null()).cloned())
+            .with_opt("media_id", c.get("media_id").filter(|v| !v.is_null()).cloned())
+            .with_opt("media_type", c.get("media_type").filter(|v| !v.is_null()).cloned())
+            .with_opt("media_metadata", c.get("media_metadata").filter(|v| !v.is_null()).cloned()),
+    )
+}
+
+/// `ReactionPacketHandler`'s row id for a post reaction.
+pub fn reaction_id(post_id: &str, author: &str, reaction_type: &str) -> String { format!("{}_{}_{}", post_id, author, reaction_type) }
diff --git a/hainet-noslop/src/hub/creator.rs b/hainet-noslop/src/hub/creator.rs
new file mode 100644
index 0000000..232bdc4
--- /dev/null
+++ b/hainet-noslop/src/hub/creator.rs
@@ -0,0 +1,523 @@
+//! START OF FILE hainet-noslop/src/hub/creator.rs
+//!
+//! What the Hub does for the creator identity while creator hosting is on. Each handler follows
+//! the phone's own (named next to it), limited to the creator's own content: a creator node never
+//! mirrors other creators (NoSlop-Discovery-Mirroring-Home-HUB-Enhancement-Plan §2, rules 1-2).
+
+use super::{content, store::Contact, tor, HubNode, Retry};
+use crate::{canon, json::JValue, keys, packet::Packet};
+use std::sync::Arc;
+use tracing::{debug, info, warn};
+
+pub(crate) struct Outcome {
+    /// Store the packet for the phone, with this inbox kind.
+    pub inbox: Option<&'static str>,
+    /// Frames to write back on the connection the packet came on.
+    pub replies: Vec<String>,
+}
+
+impl Outcome {
+    fn inbox() -> Self { Outcome { inbox: Some("packet"), replies: vec![] } }
+    fn handled() -> Self { Outcome { inbox: None, replies: vec![] } }
+}
+
+/// `MediaManager.MAX_CHUNK_BYTES`.
+pub const MAX_CHUNK_BYTES: i64 = 256 * 1024;
+/// `MediaManager.MAX_OUTBOUND_BYTES_PER_WINDOW` over `OUTBOUND_WINDOW_MS`.
+pub(crate) const MEDIA_BYTES_PER_WINDOW_PUB: i64 = 16 * 1024 * 1024;
+pub(crate) const MEDIA_WINDOW_MS_PUB: i64 = 60_000;
+/// `MediaManager.SIGNED_REQUEST_MAX_SKEW_MS`.
+const SIGNED_REQUEST_MAX_SKEW_MS: i64 = 5 * 60_000;
+/// `HandshakePacketHandler`: at most 5 auto-accepts per sender per hour.
+pub(crate) const AUTO_ACCEPTS_PER_HOUR_PUB: usize = 5;
+
+pub(crate) async fn handle(node: &Arc<HubNode>, pkt: &Packet) -> Outcome {
+    match pkt.ptype.as_str() {
+        "CONNECTION_REQUEST" => connection_request(node, pkt).await,
+        "SYNC_REQUEST" => sync_request(node, pkt).await,
+        "INVENTORY_SYNC_REQUEST" => inventory_sync_request(node, pkt).await,
+        "MEDIA_REQUEST" => media_request(node, pkt).await,
+        "MEDIA_RELAY_REQUEST" => media_relay_request(node, pkt).await,
+        "COMMENT" | "EDIT_COMMENT" | "DELETE_COMMENT" | "REACTION" => {
+            apply_engagement(node, pkt).await;
+            Outcome::inbox()
+        }
+        _ => Outcome::inbox(),
+    }
+}
+
+// --- Handshakes -------------------------------------------------------------------------------
+
+/// `HandshakePacketHandler.handleConnectionRequest`, for a request addressed to the creator identity.
+async fn connection_request(node: &Arc<HubNode>, pkt: &Packet) -> Outcome {
+    let Some(creator) = node.creator().await else { return Outcome::inbox() };
+    let Some(p) = pkt.payload.as_ref() else { return Outcome::handled() };
+    let (Some(from), Some(ts)) = (p.get_str("from_user_id"), p.get_i64("timestamp")) else { return Outcome::handled() };
+    let target = p.get_str("target_user_id").or(pkt.target_user_id.as_deref());
+    if target != Some(creator.public_key_b64.as_str()) { return Outcome::inbox(); }
+    if pkt.target_user_id.is_some() && pkt.target_user_id.as_deref() != target {
+        warn!("NOSLOP_HUB: rejected CONNECTION_REQUEST: envelope target does not match signed target");
+        return Outcome::handled();
+    }
+    // The Hub only auto-accepts a request its sender made itself (not one relayed under another key).
+    if pkt.sender_id != from { return Outcome::inbox(); }
+    let nonce = p.get_str("request_nonce").unwrap_or("");
+    let sig = pkt.signature.as_deref().or(p.get_str("signature")).unwrap_or("");
+    let username = p.get_str("from_username").unwrap_or("");
+    let home = p.get_str("from_home_node").unwrap_or("");
+    let enc = p.get_str("from_encryption_public_key").unwrap_or("");
+    let signed = canon::handshake_v2(from, username, home, enc, &creator.public_key_b64, nonce, ts, p.get_str("author_avatar_b64"), p.get_str("bio"), p.get_str("intro"));
+    if nonce.trim().is_empty() || !keys::verify(&signed, sig, from) {
+        // A legacy or forged request: the phone records "older NoSlop version" for legacy ones.
+        return Outcome::inbox();
+    }
+    let now = node.now();
+    let is_old = now - ts > 5 * 60_000;
+    let is_very_old = now - ts > 60 * 60_000;
+    let is_future = ts - now > 5 * 60_000;
+    let existing = node.store.contact_get(from).await.ok().flatten();
+    if existing.as_ref().map(|c| c.relationship == "BLOCKED").unwrap_or(false) {
+        info!("NOSLOP_HUB: ignored CONNECTION_REQUEST from blocked peer {}", tor::short(from));
+        return Outcome::handled();
+    }
+    let reply_fresh = !is_old && !is_future && node.claim_reply_slot(from, ts).await;
+
+    if let Some(c) = &existing {
+        if !c.declined_nonce.is_empty() && c.declined_nonce == nonce && c.relationship == "NONE" {
+            let mut replies = vec![];
+            if reply_fresh {
+                if let Some(w) = node.wire_for(&rejection_packet(&creator, from, now)).await { replies.push(w); }
+            }
+            info!("NOSLOP_HUB: CONNECTION_REQUEST from {} repeats a request the owner declined", tor::short(from));
+            return Outcome { inbox: None, replies };
+        }
+    }
+    if existing.is_none() && is_very_old { return Outcome::handled(); }
+    if existing.is_none() {
+        if let Ok(Some(deleted_at)) = node.store.meta_get(&format!("deleted_{}", from)).await {
+            if deleted_at.parse::<i64>().map(|d| ts <= d && now - d < 7 * 24 * 3_600_000).unwrap_or(false) {
+                warn!("NOSLOP_HUB: ignored CONNECTION_REQUEST from recently deleted peer {}", tor::short(from));
+                return Outcome::handled();
+            }
+        }
+    }
+    let profile = node.profile().await;
+    if !profile.is_creator { return Outcome::inbox(); } // creator mode off: the owner decides
+
+    let accepted_creator_contact = existing.as_ref().map(|c| c.relationship == "ACCEPTED" && c.identity == "creator").unwrap_or(false);
+    if existing.as_ref().map(|c| c.relationship == "ACCEPTED" && c.identity != "creator").unwrap_or(false) {
+        return Outcome::inbox(); // a personal contact addressing the creator identity: the phone decides
+    }
+    if accepted_creator_contact && is_old { return Outcome::handled(); }
+    let crossing = existing.as_ref().map(|c| c.relationship == "OUTGOING_PENDING").unwrap_or(false);
+    if !accepted_creator_contact && !crossing && !node.auto_accept_allowed(from, now).await {
+        return Outcome::inbox(); // over the auto-accept limit: the owner is asked
+    }
+
+    let onion = if keys::is_onion_of(from, home) { home.trim().to_ascii_lowercase() } else { keys::onion_of(from).unwrap_or_default() };
+    let contact = Contact {
+        public_key: from.to_string(),
+        identity: "creator".into(),
+        relationship: "ACCEPTED".into(),
+        is_trusted: true,
+        is_temporary: true,
+        handle: username.to_string(),
+        onion_address: onion.clone(),
+        enc_public_key: if enc.is_empty() { existing.as_ref().map(|c| c.enc_public_key.clone()).unwrap_or_default() } else { enc.to_string() },
+        source: existing.as_ref().map(|c| c.source.clone()).unwrap_or_else(|| "hub".into()),
+        declined_nonce: String::new(),
+    };
+    if let Err(e) = node.store.contact_upsert(&contact, now).await { warn!("NOSLOP_HUB: could not store follower: {}", e); return Outcome::inbox(); }
+    let hs = handshake_packet(&creator, &profile, from, nonce, now);
+    let mut replies = vec![];
+    if reply_fresh {
+        if let Some(w) = node.wire_for(&hs).await { replies.push(w); }
+    }
+    if replies.is_empty() && !onion.is_empty() { node.deliver(onion, hs, Retry::Spool); }
+    info!("NOSLOP_HUB: auto-accepted follower {} for the creator identity{}", tor::short(from), if replies.is_empty() { "" } else { " (answered on their connection)" });
+    Outcome { inbox: Some("creator_follower_accepted"), replies }
+}
+
+/// `MeshSocialRepository.acceptConnectionRequest`: the `USER_HANDSHAKE` as the creator identity,
+/// echoing the requester's nonce, with the creator profile (never the personal one).
+pub(crate) fn handshake_packet(creator: &keys::Identity, profile: &super::CreatorProfile, to: &str, nonce: &str, now: i64) -> Packet {
+    let name = if profile.display_name.is_empty() { profile.handle.clone() } else { profile.display_name.clone() };
+    let signed = canon::handshake_v2(&creator.public_key_b64, &name, &creator.onion, &creator.enc_public_key_b64, to, nonce, now, profile.avatar_b64.as_deref(), profile.bio.as_deref(), None);
+    let sig = creator.sign(&signed);
+    let payload = JValue::obj()
+        .with("id", JValue::str(uuid::Uuid::new_v4().to_string()))
+        .with("from_user_id", JValue::str(&creator.public_key_b64))
+        .with("from_username", JValue::str(&name))
+        .with("from_display_name", JValue::str(&name))
+        .with_opt("author_avatar_b64", profile.avatar_b64.clone().map(JValue::Str))
+        .with_opt("bio", profile.bio.clone().map(JValue::Str))
+        .with("from_home_node", JValue::str(&creator.onion))
+        .with("from_encryption_public_key", JValue::str(&creator.enc_public_key_b64))
+        .with("timestamp", JValue::int(now))
+        .with("in_reply_to_nonce", JValue::str(nonce))
+        .with("target_user_id", JValue::str(to))
+        .with("version", JValue::int(2));
+    let mut p = Packet::new("USER_HANDSHAKE", &creator.public_key_b64, Some(to), payload, 3);
+    p.signature = Some(sig);
+    p
+}
+
+/// `buildConnectionRejectedPacket`.
+fn rejection_packet(creator: &keys::Identity, to: &str, now: i64) -> Packet {
+    let sig = creator.sign(&canon::connection_rejected(&creator.public_key_b64, now));
+    let payload = JValue::obj()
+        .with("from_user_id", JValue::str(&creator.public_key_b64))
+        .with("timestamp", JValue::int(now))
+        .with("signature", JValue::str(&sig));
+    let mut p = Packet::new("CONNECTION_REJECTED", &creator.public_key_b64, Some(to), payload, 3);
+    p.signature = Some(sig);
+    p
+}
+
+// --- Sync -------------------------------------------------------------------------------------
+
+/// The requester when it is one of the creator identity's contacts (the phone answers only peers it
+/// knows); `None` otherwise.
+async fn creator_contact(node: &HubNode, key: &str) -> Option<Contact> {
+    let c = node.store.contact_get(key).await.ok().flatten()?;
+    if c.relationship == "BLOCKED" || c.identity != "creator" || !tor::is_valid_onion(&c.onion_address) { return None; }
+    Some(c)
+}
+
+/// `SyncPacketHandler.handleSyncRequest`, for the creator identity: the creator's public posts since
+/// `since`, then the comments and reactions on them, in batches of 25, each its own `SYNC_RESPONSE`.
+async fn sync_request(node: &Arc<HubNode>, pkt: &Packet) -> Outcome {
+    let Some(contact) = creator_contact(node, &pkt.sender_id).await else { return Outcome::inbox() };
+    let since = pkt.p_i64("since").unwrap_or(0);
+    let Some(creator) = node.creator().await else { return Outcome::inbox() };
+    let all = node.store.posts_since(&creator.public_key_b64, 0).await.unwrap_or_default();
+    let posts: Vec<_> = all.iter().filter(|p| p.timestamp >= since).collect();
+    let ids: Vec<String> = all.iter().map(|p| p.id.clone()).collect();
+    let comments = node.store.comments_for_posts_since(&ids, since).await.unwrap_or_default();
+    let reactions = node.store.reactions_for_posts_since(&ids, since).await.unwrap_or_default();
+    let post_values: Vec<JValue> = posts.iter().filter_map(|p| crate::json::parse(&p.payload).ok()).collect();
+    info!("NOSLOP_HUB: SYNC_REQUEST from follower {} — {} posts, {} comments, {} reactions", tor::short(&pkt.sender_id), post_values.len(), comments.len(), reactions.len());
+    send_sync_batches(node, &creator, &contact, post_values, parse_all(&comments), parse_all(&reactions));
+    Outcome::handled()
+}
+
+/// `SyncPacketHandler.handleInventorySyncRequest`, for the creator identity: posts the requester is
+/// missing or holds in another version, and the engagement of the last year on every creator post.
+async fn inventory_sync_request(node: &Arc<HubNode>, pkt: &Packet) -> Outcome {
+    let Some(contact) = creator_contact(node, &pkt.sender_id).await else { return Outcome::inbox() };
+    let Some(creator) = node.creator().await else { return Outcome::inbox() };
+    let mut theirs = std::collections::HashMap::new();
+    if let Some(JValue::Arr(items)) = pkt.p("inventory") {
+        for it in items.iter().take(100_000) {
+            if let (Some(id), Some(h)) = (it.get_str("id"), it.get_str("hash")) { theirs.insert(id.to_string(), h.to_string()); }
+        }
+    }
+    let all = node.store.posts_since(&creator.public_key_b64, 0).await.unwrap_or_default();
+    let missing: Vec<JValue> = all.iter()
+        .filter(|p| theirs.get(&p.id).map(|h| *h != content::inventory_hash(&p.id, &p.author_id, &p.content, p.timestamp)).unwrap_or(true))
+        .filter_map(|p| crate::json::parse(&p.payload).ok()).collect();
+    let ids: Vec<String> = all.iter().map(|p| p.id.clone()).collect();
+    let cutoff = node.now() - 365 * 24 * 3_600_000;
+    let comments = node.store.comments_for_posts_since(&ids, cutoff).await.unwrap_or_default();
+    let reactions = node.store.reactions_for_posts_since(&ids, cutoff).await.unwrap_or_default();
+    info!("NOSLOP_HUB: INVENTORY_SYNC_REQUEST from follower {} — {} of {} posts missing, {} comments, {} reactions", tor::short(&pkt.sender_id), missing.len(), all.len(), comments.len(), reactions.len());
+    send_sync_batches(node, &creator, &contact, missing, parse_all(&comments), parse_all(&reactions));
+    Outcome::handled()
+}
+
+fn parse_all(rows: &[String]) -> Vec<JValue> { rows.iter().filter_map(|r| crate::json::parse(r).ok()).collect() }
+
+fn send_sync_batches(node: &Arc<HubNode>, creator: &keys::Identity, contact: &Contact, posts: Vec<JValue>, comments: Vec<JValue>, reactions: Vec<JValue>) {
+    let node = node.clone();
+    let sender = creator.public_key_b64.clone();
+    let (to, onion) = (contact.public_key.clone(), contact.onion_address.clone());
+    tokio::spawn(async move {
+        let mut batches = vec![];
+        for b in posts.chunks(25) { batches.push((b.to_vec(), vec![], vec![])); }
+        for b in comments.chunks(25) { batches.push((vec![], b.to_vec(), vec![])); }
+        for b in reactions.chunks(25) { batches.push((vec![], vec![], b.to_vec())); }
+        for (p, c, r) in batches {
+            let payload = JValue::obj().with("posts", JValue::Arr(p)).with("comments", JValue::Arr(c)).with("reactions", JValue::Arr(r));
+            let pkt = Packet::new("SYNC_RESPONSE", &sender, Some(&to), payload, 3);
+            node.deliver(onion.clone(), pkt, Retry::Sync);
+            tokio::time::sleep(std::time::Duration::from_millis(500)).await;
+        }
+    });
+}
