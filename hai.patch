@@ -0,0 +1,111 @@
+//! START OF FILE hainet-noslop/src/canon.rs
+//!
+//! The canonical strings NoSlop signs, reproduced exactly (`CryptoService.kt`, `EnvelopeAuth.kt`,
+//! `MediaManager.mediaRequestSigningString`, `MeshSocialRepository.announceCreatorPresence`).
+
+/// `CryptoService.encodeForSigning`: each part as `<length>:<part>`, `None` as `0:`.
+///
+/// The length is Kotlin's `String.length`, i.e. the number of **UTF-16 code units**, not bytes and
+/// not characters: `"😀x"` is `3:😀x`.
+pub fn encode_for_signing(parts: &[Option<&str>]) -> String {
+    let mut out = String::new();
+    for p in parts {
+        match p {
+            None => out.push_str("0:"),
+            Some(s) => {
+                out.push_str(&s.encode_utf16().count().to_string());
+                out.push(':');
+                out.push_str(s);
+            }
+        }
+    }
+    out
+}
+
+/// Shorthand for the common case where every part is present.
+pub fn efs(parts: &[&str]) -> String {
+    let v: Vec<Option<&str>> = parts.iter().map(|p| Some(*p)).collect();
+    encode_for_signing(&v)
+}
+
+/// `CryptoService.canonicalAnnouncePeerV2`.
+pub fn announce_peer_v2(author_id: &str, onion: Option<&str>, timestamp: i64) -> String {
+    efs(&["noslop-announce-v2", author_id, onion.unwrap_or(""), &timestamp.to_string()])
+}
+
+/// `CryptoService.canonicalHandshakePayloadV2`. `intro` is appended only when present.
+#[allow(clippy::too_many_arguments)]
+pub fn handshake_v2(
+    from_user_id: &str,
+    from_username: &str,
+    from_home_node: &str,
+    from_enc_pub: &str,
+    target_user_id: &str,
+    nonce: &str,
+    timestamp: i64,
+    avatar_b64: Option<&str>,
+    bio: Option<&str>,
+    intro: Option<&str>,
+) -> String {
+    let ts = timestamp.to_string();
+    let mut parts: Vec<Option<&str>> = vec![
+        Some("noslop-hs-v2"), Some(from_user_id), Some(from_username), Some(from_home_node),
+        Some(from_enc_pub), Some(target_user_id), Some(nonce), Some(&ts), avatar_b64, bio,
+    ];
+    if let Some(i) = intro { parts.push(Some(i)); }
+    encode_for_signing(&parts)
+}
+
+/// `MediaManager.mediaRequestSigningString` (`noslop-media-req-v1`).
+#[allow(clippy::too_many_arguments)]
+pub fn media_request(
+    sender_id: &str,
+    target_user_id: Option<&str>,
+    media_id: &str,
+    chunk_index: i64,
+    chunk_size: i64,
+    byte_offset: Option<i64>,
+    byte_length: Option<i64>,
+    timestamp: Option<i64>,
+) -> String {
+    efs(&[
+        "noslop-media-req-v1", sender_id, target_user_id.unwrap_or(""), media_id,
+        &chunk_index.to_string(), &chunk_size.to_string(),
+        &byte_offset.unwrap_or(-1).to_string(), &byte_length.unwrap_or(-1).to_string(),
+        &timestamp.unwrap_or(0).to_string(),
+    ])
+}
+
+/// What `announceCreatorPresence` signs for `ANNOUNCE_DISCOVERABLE` (colon-joined, the periodic
+/// announcement carries no avatar, so that field is empty).
+#[allow(clippy::too_many_arguments)]
+pub fn discoverable(
+    author_id: &str, handle: &str, onion: &str, enc_pub: &str, is_creator: bool,
+    fund_me_link: Option<&str>, avatar_b64: Option<&str>, bio: Option<&str>, timestamp: i64,
+) -> String {
+    format!(
+        "{}:{}:{}:{}:{}:{}:{}:{}:{}",
+        author_id, handle, onion, enc_pub, is_creator,
+        fund_me_link.unwrap_or(""), avatar_b64.unwrap_or(""), bio.unwrap_or(""), timestamp
+    )
+}
+
+/// `CONNECTION_REJECTED` (`buildConnectionRejectedPacket`): `encodeForSigning(fromUserId, timestamp)`.
+pub fn connection_rejected(from_user_id: &str, timestamp: i64) -> String {
+    efs(&[from_user_id, &timestamp.to_string()])
+}
+
+/// Hub owner-API request signature (new in this Hub, `noslop-hub-api-v1`): binds method, path,
+/// timestamp, nonce and the SHA-256 (hex) of the raw request body bytes.
+pub fn hub_api_request(method: &str, path: &str, timestamp: i64, nonce: &str, body_sha256_hex: &str) -> String {
+    efs(&["noslop-hub-api-v1", method, path, &timestamp.to_string(), nonce, body_sha256_hex])
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn utf16_lengths() {
+        assert_eq!(encode_for_signing(&[Some("😀x"), None, Some("")]), "3:😀x0:0:");
+    }
+}
diff --git a/hainet-noslop/src/dm.rs b/hainet-noslop/src/dm.rs
new file mode 100644
index 0000000..45c21c5
--- /dev/null
+++ b/hainet-noslop/src/dm.rs
@@ -0,0 +1,114 @@
+//! START OF FILE hainet-noslop/src/dm.rs
+//!
+//! NoSlop direct-message crypto (`CryptoService.encryptDMV2` / `decryptDMV2` / `decryptDM`).
+//!
+//! v2: `k_dir = HKDF-SHA256(ikm = X25519(myPriv, theirPub), salt = SHA-256(sorted(senderEd, recipientEd)),
+//! info = "noslop-dm-v2|<senderEd>-><recipientEd>")`, ChaCha20-Poly1305 with a 12-byte IV and AAD
+//! `encodeForSigning(domain, senderEd, recipientEd, msgId, groupId ?: "", timestamp)`.
+//! v1 (receive only): key = SHA3-256(shared secret), no AAD.
+
+use crate::{canon::efs, keys};
+use chacha20poly1305::{aead::{Aead, KeyInit, Payload}, ChaCha20Poly1305, Nonce};
+use hkdf::Hkdf;
+use rand::RngCore;
+use sha2::{Digest, Sha256};
+use sha3::Sha3_256;
+use x25519_dalek::{PublicKey, StaticSecret};
+
+pub const DM_AAD_MESSAGE: &str = "noslop-dm-v2";
+pub const DM_AAD_ACK: &str = "noslop-dm-ack-v3";
+
+#[derive(Debug, thiserror::Error, PartialEq)]
+pub enum DmError {
+    #[error("bad key: {0}")]
+    Key(#[from] keys::KeyError),
+    #[error("key agreement produced an all-zero secret")]
+    ZeroSecret,
+    #[error("decryption failed")]
+    Decrypt,
+    #[error("bad nonce")]
+    Nonce,
+}
+
+fn shared_secret(my_priv: &StaticSecret, their_enc_pub_b64: &str) -> Result<[u8; 32], DmError> {
+    let their = PublicKey::from(keys::x25519_public_raw(their_enc_pub_b64)?);
+    let s = my_priv.diffie_hellman(&their).to_bytes();
+    // Bouncy Castle's X25519Agreement refuses an all-zero result (small-order public key).
+    if s.iter().all(|b| *b == 0) { return Err(DmError::ZeroSecret); }
+    Ok(s)
+}
+
+/// `CryptoService.deriveDirectionalKeyV2`.
+pub fn directional_key_v2(shared: &[u8; 32], sender_ed: &str, recipient_ed: &str) -> [u8; 32] {
+    let (a, b) = if sender_ed <= recipient_ed { (sender_ed, recipient_ed) } else { (recipient_ed, sender_ed) };
+    let mut h = Sha256::new();
+    h.update(a.as_bytes());
+    h.update(b.as_bytes());
+    let salt = h.finalize();
+    let info = format!("noslop-dm-v2|{}->{}", sender_ed, recipient_ed);
+    let hk = Hkdf::<Sha256>::new(Some(&salt), shared);
+    let mut out = [0u8; 32];
+    hk.expand(info.as_bytes(), &mut out).expect("32 bytes is a valid HKDF output length");
+    out
+}
+
+/// `CryptoService.canonicalDmAadV2`.
+pub fn aad_v2(domain: &str, sender_ed: &str, recipient_ed: &str, msg_id: &str, group_id: Option<&str>, timestamp: i64) -> String {
+    efs(&[domain, sender_ed, recipient_ed, msg_id, group_id.unwrap_or(""), &timestamp.to_string()])
+}
+
+/// Encrypts with an explicit IV (tests and deterministic vectors). Returns (ciphertext_b64, iv_b64).
+#[allow(clippy::too_many_arguments)]
+pub fn encrypt_v2_with_iv(
+    plaintext: &str, their_enc_pub_b64: &str, my_priv: &StaticSecret, sender_ed: &str, recipient_ed: &str,
+    msg_id: &str, group_id: Option<&str>, timestamp: i64, domain: &str, iv: [u8; 12],
+) -> Result<(String, String), DmError> {
+    let shared = shared_secret(my_priv, their_enc_pub_b64)?;
+    let key = directional_key_v2(&shared, sender_ed, recipient_ed);
+    let aad = aad_v2(domain, sender_ed, recipient_ed, msg_id, group_id, timestamp);
+    let cipher = ChaCha20Poly1305::new((&key).into());
+    let ct = cipher
+        .encrypt(Nonce::from_slice(&iv), Payload { msg: plaintext.as_bytes(), aad: aad.as_bytes() })
+        .map_err(|_| DmError::Decrypt)?;
+    Ok((keys::b64_encode(&ct), keys::b64_encode(&iv)))
+}
+
+/// `CryptoService.encryptDMV2` (random IV).
+#[allow(clippy::too_many_arguments)]
+pub fn encrypt_v2(
+    plaintext: &str, their_enc_pub_b64: &str, my_priv: &StaticSecret, sender_ed: &str, recipient_ed: &str,
+    msg_id: &str, group_id: Option<&str>, timestamp: i64, domain: &str,
+) -> Result<(String, String), DmError> {
+    let mut iv = [0u8; 12];
+    rand::rngs::OsRng.fill_bytes(&mut iv);
+    encrypt_v2_with_iv(plaintext, their_enc_pub_b64, my_priv, sender_ed, recipient_ed, msg_id, group_id, timestamp, domain, iv)
+}
+
+/// `CryptoService.decryptDMV2`.
+#[allow(clippy::too_many_arguments)]
+pub fn decrypt_v2(
+    ciphertext_b64: &str, nonce_b64: &str, their_enc_pub_b64: &str, my_priv: &StaticSecret, sender_ed: &str,
+    recipient_ed: &str, msg_id: &str, group_id: Option<&str>, timestamp: i64, domain: &str,
+) -> Result<String, DmError> {
+    let shared = shared_secret(my_priv, their_enc_pub_b64)?;
+    let key = directional_key_v2(&shared, sender_ed, recipient_ed);
+    let iv = keys::b64_decode(nonce_b64)?;
+    if iv.len() != 12 { return Err(DmError::Nonce); }
+    let aad = aad_v2(domain, sender_ed, recipient_ed, msg_id, group_id, timestamp);
+    let cipher = ChaCha20Poly1305::new((&key).into());
+    let pt = cipher
+        .decrypt(Nonce::from_slice(&iv), Payload { msg: &keys::b64_decode(ciphertext_b64)?, aad: aad.as_bytes() })
+        .map_err(|_| DmError::Decrypt)?;
+    String::from_utf8(pt).map_err(|_| DmError::Decrypt)
+}
+
+/// `CryptoService.decryptDM` (legacy v1, receive only).
+pub fn decrypt_v1(ciphertext_b64: &str, nonce_b64: &str, their_enc_pub_b64: &str, my_priv: &StaticSecret) -> Result<String, DmError> {
+    let shared = shared_secret(my_priv, their_enc_pub_b64)?;
+    let key: [u8; 32] = Sha3_256::digest(shared).into();
+    let iv = keys::b64_decode(nonce_b64)?;
+    if iv.len() != 12 { return Err(DmError::Nonce); }
+    let cipher = ChaCha20Poly1305::new((&key).into());
+    let pt = cipher.decrypt(Nonce::from_slice(&iv), keys::b64_decode(ciphertext_b64)?.as_slice()).map_err(|_| DmError::Decrypt)?;
+    String::from_utf8(pt).map_err(|_| DmError::Decrypt)
+}
